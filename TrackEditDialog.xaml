<Window x:Class="Sonator.TrackEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Sonator.Models"
        Title="Track"
        Width="420"
        Height="330"
        Background="#1B2330"
        Foreground="#C4CFDA"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#212D3A" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="BorderBrush" Value="#607A96" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A3948" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#354D69" />
                    <Setter Property="BorderBrush" Value="#7EB2FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="126" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Text="Track name" />
        <TextBox x:Name="TrackNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding TrackName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" Text="Instrument" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Instrument, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" Text="Track type" />
        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" SelectedValuePath="Tag" SelectedValue="{Binding TrackType}">
            <ComboBoxItem Content="MIDI CH" Tag="{x:Static models:PatternTrackType.MidiChannel}" />
            <ComboBoxItem Content="VST Instrument" Tag="{x:Static models:PatternTrackType.VstInstrument}" />
            <ComboBoxItem Content="Audio Input" Tag="{x:Static models:PatternTrackType.AudioInput}" />
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" Text="Source / route" />
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,8" Text="MIDI channel" />
        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Text="{Binding ChannelText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,8" Text="Base note (0-127)" />
        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Text="{Binding NoteNumberText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="6"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="#D98A8A"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="84" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="OK" Width="84" IsDefault="True" Click="OkButton_Click" />
        </StackPanel>
    </Grid>
</Window>
