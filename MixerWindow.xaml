<Window x:Class="Sonator.MixerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sonator"
        Title="Mixer"
        Width="900"
        Height="700"
        MinHeight="560"
        Background="#121315"
        Foreground="#262626"
        FontFamily="Arial"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <!-- A console in the manner of the big studio desks: anthracite brushed-metal channel modules screwed into a dark
         frame, knurled knobs with coloured caps, long faders with a printed dB scale, lit buttons, and the
         track's name on a strip of tape at the bottom. -->
    <Window.Resources>
        <local:SendControlsConverter x:Key="SendControls" />
        <local:SameValueConverter x:Key="SameValue" />
        <BooleanToVisibilityConverter x:Key="VisibleWhenLinked" />

        <!-- The overload lamp over a VU meter: a dark red lens, lit bright red with a glow while Tag is true. -->
        <Style x:Key="ClipLamp" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Stroke" Value="#2A0A08" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Fill">
                <Setter.Value>
                    <RadialGradientBrush GradientOrigin="0.35,0.3">
                        <GradientStop Color="#7A2A24" Offset="0" />
                        <GradientStop Color="#4A120E" Offset="1" />
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Fill">
                        <Setter.Value>
                            <RadialGradientBrush GradientOrigin="0.35,0.3">
                                <GradientStop Color="#FFD8CC" Offset="0" />
                                <GradientStop Color="#FF3A2A" Offset="0.45" />
                                <GradientStop Color="#C0100A" Offset="1" />
                            </RadialGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF3A2A" ShadowDepth="0" BlurRadius="8" Opacity="0.9" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The ink printed on the aluminium. -->
        <Style x:Key="Legend" TargetType="TextBlock">
            <Setter Property="FontSize" Value="7.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#2A2C2E" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- A cross-head screw holding the module in the frame. -->
        <DataTemplate x:Key="Screw">
            <Grid Width="7" Height="7" HorizontalAlignment="Center">
                <Ellipse Stroke="#191A1C" StrokeThickness="0.6">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.3,0.3">
                            <GradientStop Color="#C0C1C3" Offset="0" />
                            <GradientStop Color="#535353" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Line X1="1.6" Y1="3.5" X2="5.4" Y2="3.5" Stroke="#292929" StrokeThickness="0.9" />
                <Line X1="3.5" Y1="1.6" X2="3.5" Y2="5.4" Stroke="#292929" StrokeThickness="0.9" />
            </Grid>
        </DataTemplate>

        <!-- A small console push-button. Lit buttons set their own colours with triggers. -->
        <Style x:Key="ConsoleButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E4E7EA" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#646464" Offset="0" />
                        <GradientStop Color="#363636" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
        </Style>

        <!-- The same key as a switch that stays down and lights while it is on, as the master's LINK. -->
        <Style x:Key="ConsoleToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#E4E7EA" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#646464" Offset="0" />
                        <GradientStop Color="#363636" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
        </Style>

        <!-- The fader's cap: grey with a white line across, as on the classic desks; the master's is red. -->
        <ControlTemplate x:Key="FaderCap" TargetType="Thumb">
            <Border CornerRadius="2" BorderBrush="#0B0C0E" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#929395" Offset="0" />
                        <GradientStop Color="#484848" Offset="0.45" />
                        <GradientStop Color="#353535" Offset="0.55" />
                        <GradientStop Color="#636363" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Rectangle Height="2" Fill="#F4F4F0" VerticalAlignment="Center" />
            </Border>
        </ControlTemplate>
        <ControlTemplate x:Key="MasterFaderCap" TargetType="Thumb">
            <Border CornerRadius="2" BorderBrush="#0B0C0E" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E0574E" Offset="0" />
                        <GradientStop Color="#9C2A23" Offset="0.45" />
                        <GradientStop Color="#7A1E19" Offset="0.55" />
                        <GradientStop Color="#B8463E" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Rectangle Height="2" Fill="#F4F4F0" VerticalAlignment="Center" />
            </Border>
        </ControlTemplate>

        <!-- A long fader in a dark slot cut into the panel. -->
        <Style x:Key="ConsoleFader" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="SmallChange" Value="0.01" />
            <Setter Property="LargeChange" Value="0.05" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Width="5" Margin="0,10" CornerRadius="2" Background="#090A0C" BorderBrush="#595959" BorderThickness="0,0,1,1" HorizontalAlignment="Center" />
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Height="26" Width="20" Cursor="SizeNS" Template="{StaticResource FaderCap}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MasterFader" TargetType="Slider" BasedOn="{StaticResource ConsoleFader}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Width="5" Margin="0,10" CornerRadius="2" Background="#090A0C" BorderBrush="#595959" BorderThickness="0,0,1,1" HorizontalAlignment="Center" />
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Height="26" Width="24" Cursor="SizeNS" Template="{StaticResource MasterFaderCap}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The recessed display of a module's inserts: one line per effect, dimmed while it is off. -->
        <DataTemplate x:Key="InsertTemplate">
            <TextBlock Text="{Binding Name}" FontFamily="Arial Narrow, Arial" FontSize="11" Margin="3,2,2,3" TextTrimming="CharacterEllipsis"
                       Cursor="Hand" ToolTip="{Binding Name}" MouseLeftButtonUp="Insert_MouseLeftButtonUp">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#7FD4FF" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Foreground" Value="#707070" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPluginMissing}" Value="True">
                                <Setter Property="Foreground" Value="#E6C45B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <!-- A module: light grey satin aluminium with a dark hairline edge, as the lower part of SSL's panels. -->
        <Style x:Key="Module" TargetType="Border">
            <Setter Property="Width" Value="60" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#161616" />
            <Setter Property="Background" Value="{x:Static local:BrushedMetal.Light}" />
        </Style>

        <!-- A send, a knob with its bus's cap colour, and the bus's name under it. -->
        <DataTemplate x:Key="SendTemplate">
            <StackPanel Margin="0,0,0,2">
                <local:Knob Width="34" Height="34" Look="Console" Accent="{Binding Cap}" DefaultPosition="0.75" Position="{Binding Level}">
                    <local:Knob.ToolTip>
                        <TextBlock>
                            <Run Text="{Binding Bus.Name, Mode=OneWay}" /><Run Text=" send: " /><Run Text="{Binding LevelDisplay, Mode=OneWay}" />
                            <LineBreak /><Run Text="Drag up or down; double-click for 0 dB" />
                        </TextBlock>
                    </local:Knob.ToolTip>
                </local:Knob>
                <TextBlock Style="{StaticResource Legend}" Text="{Binding Bus.Name}" FontSize="7" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="6">
        <!-- The master module, at the right end of the desk; drag its left edge to make it wider. -->
        <Border x:Name="MasterStrip" DockPanel.Dock="Right" Style="{StaticResource Module}" Width="132" Margin="0" SizeChanged="MasterStrip_SizeChanged">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <ContentControl ContentTemplate="{StaticResource Screw}" Margin="0,3,0,2" Focusable="False" />
                    <Border Height="5" Background="#B8322B" Margin="4,0" />
                    <TextBlock Style="{StaticResource Legend}" Text="INSERT" Margin="0,4,0,1" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="15" Margin="4,4,4,0" Background="#101113" CornerRadius="2">
                        <TextBlock Text="{Binding MasterVolumeDisplay}" FontFamily="Consolas" FontSize="9" Foreground="#FF8A3D"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Height="18" Margin="3,4,3,0" Background="#EFE6C8" CornerRadius="1">
                        <TextBlock Text="Master" FontFamily="Segoe Print" FontSize="9" Foreground="#1E2A6B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ContentControl ContentTemplate="{StaticResource Screw}" Margin="0,4,0,3" Focusable="False" />
                </StackPanel>
                <!-- The stereo master: a fader for each side, moving together while LINK is on. -->
                <!-- The two faders stay side by side, however wide the strip, so one hand rides both. -->
                <Grid DockPanel.Dock="Bottom" Height="230" Margin="4,6,4,0" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="20" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- A LED meter for each side, each just outside its fader, the scale outside the left one; the
                         empty column on the right keeps the faders in the middle. -->
                    <local:FaderScale ThumbLength="26" />
                    <local:LedMeter Grid.Column="1" Segments="30" RedSegments="5" Margin="0,13" Level="{Binding MasterLevelLeft}" ToolTip="Master level, left side" />
                    <Slider Grid.Column="2" Style="{StaticResource MasterFader}" Value="{Binding MasterVolumeLeft}"
                            ToolTip="Master, left side. With LINK on, the right side follows" />
                    <Slider Grid.Column="3" Style="{StaticResource MasterFader}" Value="{Binding MasterVolumeRight}"
                            ToolTip="Master, right side. With LINK on, the left side follows" />
                    <local:LedMeter Grid.Column="4" Segments="30" RedSegments="5" Margin="0,13" Level="{Binding MasterLevelRight}" ToolTip="Master level, right side" />
                    <!-- While LINK is on, the aluminium bar laid across both caps: drag it to ride both with one finger. -->
                    <local:FaderLinkBar Grid.Column="2" Grid.ColumnSpan="2" ThumbLength="26"
                                        Left="{Binding MasterVolumeLeft}" Right="{Binding MasterVolumeRight}"
                                        Visibility="{Binding IsMasterLinked, Converter={StaticResource VisibleWhenLinked}}"
                                        ToolTip="The link bar: drag it to move both master faders together" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Legend}" Text="L" FontSize="7" Margin="0,1,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Legend}" Text="L" Margin="0,1,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Legend}" Text="R" Margin="0,1,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource Legend}" Text="R" FontSize="7" Margin="0,1,0,0" />
                </Grid>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource ConsoleButton}" Content="FX" Margin="4,3,4,0" Tag="{Binding MasterTrack}" Click="Fx_Click"
                            ToolTip="Open the master's effect rack: its effects run on the whole mix" />
                    <TextBlock Style="{StaticResource Legend}" Text="MASTER" FontSize="11" Margin="0,8,0,2" />
                    <!-- Over each VU meter its overload lamp, lit red when that side reaches full scale. -->
                    <Grid Margin="3,0,3,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="Left side clipping: it reached full scale">
                            <Ellipse Style="{StaticResource ClipLamp}" Tag="{Binding IsMasterClippingLeft}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="Right side clipping: it reached full scale">
                            <Ellipse Style="{StaticResource ClipLamp}" Tag="{Binding IsMasterClippingRight}" />
                        </StackPanel>
                    </Grid>
                    <!-- The mix's left and right levels, on moving-needle meters side by side. -->
                    <Grid x:Name="VuRow" Height="48" Margin="3,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:VuMeter Label="L" Peak="{Binding MasterPeakLeft}" ReferenceDbfs="{Binding VuReferenceDbfs}" ToolTip="{Binding VuReferenceDisplay}" />
                        <local:VuMeter Grid.Column="2" Label="R" Peak="{Binding MasterPeakRight}" ReferenceDbfs="{Binding VuReferenceDbfs}" ToolTip="{Binding VuReferenceDisplay}" />
                    </Grid>
                    <ToggleButton Style="{StaticResource ConsoleToggle}" Content="LINK" Margin="22,8,10,0" IsChecked="{Binding IsMasterLinked}"
                                  ToolTip="Link the two master faders, so they move together. Off, each sets its own side" />
                </StackPanel>
                <!-- The oscillator, as on a studio desk's master section, to line the VU meters up: a steady tone at
                     100 Hz, 1 kHz, 10 kHz or 20 kHz, which the meters always see at the reference level (-18 dBFS);
                     CAL is turned until the needles sit on 0. LEVEL only sets how loud the tone is heard. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource Legend}" Text="OSCILLATOR" Margin="0,0,0,3" />
                    <UniformGrid Columns="4" Margin="3,0">
                        <RadioButton Style="{StaticResource ConsoleToggle}" GroupName="ToneFrequency" Content="100" Margin="1,0" FontSize="8"
                                     IsChecked="{Binding ToneFrequency, Converter={StaticResource SameValue}, ConverterParameter=100}" ToolTip="Tone at 100 Hz" />
                        <RadioButton Style="{StaticResource ConsoleToggle}" GroupName="ToneFrequency" Content="1k" Margin="1,0" FontSize="8"
                                     IsChecked="{Binding ToneFrequency, Converter={StaticResource SameValue}, ConverterParameter=1000}" ToolTip="Tone at 1 kHz, the usual line-up tone" />
                        <RadioButton Style="{StaticResource ConsoleToggle}" GroupName="ToneFrequency" Content="10k" Margin="1,0" FontSize="8"
                                     IsChecked="{Binding ToneFrequency, Converter={StaticResource SameValue}, ConverterParameter=10000}" ToolTip="Tone at 10 kHz" />
                        <RadioButton Style="{StaticResource ConsoleToggle}" GroupName="ToneFrequency" Content="20k" Margin="1,0" FontSize="8"
                                     IsChecked="{Binding ToneFrequency, Converter={StaticResource SameValue}, ConverterParameter=20000}" ToolTip="Tone at 20 kHz" />
                    </UniformGrid>
                    <Grid Margin="3,5,3,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <local:Knob Width="30" Height="30" Look="Console" Accent="#383838" DefaultPosition="0.4" Position="{Binding ToneLevelPosition}"
                                        ToolTip="{Binding ToneLevelDisplay, StringFormat=How loud the tone is heard: {0}. The meters see it at -18 dBFS}" />
                            <TextBlock Style="{StaticResource Legend}" Text="LEVEL" FontSize="7" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ConsoleToggle}" Content="TONE" Width="38" VerticalAlignment="Top" Margin="0,7,0,0"
                                      IsChecked="{Binding IsToneOn}" ToolTip="Send the test tone through the master" />
                        <StackPanel Grid.Column="2">
                            <local:Knob Width="30" Height="30" Look="Console" Accent="#9C1C22" DefaultPosition="0.5" Position="{Binding VuReferencePosition}"
                                        ToolTip="{Binding VuReferenceDisplay}" />
                            <TextBlock Style="{StaticResource Legend}" Text="CAL" FontSize="7" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <!-- The inserts stop at ten effects' worth, as on the other strips; the panel shows below them. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="40" MaxHeight="184" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Margin="4,0,4,0" Background="#151618" CornerRadius="2" BorderBrush="#595959" BorderThickness="0,0,1,1">
                        <ItemsControl ItemsSource="{Binding MasterTrack.Effects}" ItemTemplate="{StaticResource InsertTemplate}" Tag="{Binding MasterTrack}" />
                    </Border>
                    <!-- Under the inserts, a LED spectrum analyser of what goes out to the audio output. -->
                    <local:SpectrumAnalyzer Grid.Row="1" Source="{Binding}" Margin="4,6,4,0" MinHeight="40" MaxHeight="150" VerticalAlignment="Top"
                                            ToolTip="The spectrum of what goes out to the audio output, from 31.5 Hz to 16 kHz" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- The master strip's left edge, to drag. -->
        <Thumb DockPanel.Dock="Right" Width="6" Cursor="SizeWE" Focusable="False" ToolTip="Drag to make the master strip wider or narrower"
               DragDelta="MasterGrip_DragDelta" DragCompleted="MasterGrip_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border Width="2" Margin="0,40" CornerRadius="1" Background="#3A3C3F" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding Tracks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- One track's channel module, top to bottom as the sound goes: inserts, sends, pan, mute and
                             solo, the fader with its meter, and the name on tape. -->
                        <Border PreviewMouseLeftButtonDown="Strip_PreviewMouseLeftButtonDown">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Module}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#FF963A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <ContentControl ContentTemplate="{StaticResource Screw}" Margin="0,3,0,2" Focusable="False" />
                                    <Border Height="5" Background="{Binding TrackColorBrush}" Margin="4,0" />
                                    <TextBlock Style="{StaticResource Legend}" Text="INSERT" Margin="0,4,0,1" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom">
                                    <Border Height="15" Margin="4,4,4,0" Background="#101113" CornerRadius="2">
                                        <TextBlock Text="{Binding VolumeDisplay}" FontFamily="Consolas" FontSize="8.5" Foreground="#FF8A3D"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <!-- The scribble strip: the track's name on a strip of tape. -->
                                    <Border Height="18" Margin="3,4,3,0" Background="#EFE6C8" CornerRadius="1" Cursor="Hand"
                                            ToolTip="{Binding Name}" MouseLeftButtonUp="TrackName_MouseLeftButtonUp">
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe Print" FontSize="9" Foreground="#1E2A6B"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0" />
                                    </Border>
                                    <ContentControl ContentTemplate="{StaticResource Screw}" Margin="0,4,0,3" Focusable="False" />
                                </StackPanel>
                                <Grid DockPanel.Dock="Bottom" Height="230" Margin="1,6,3,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="17" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="5" />
                                    </Grid.ColumnDefinitions>
                                    <local:FaderScale ThumbLength="26" />
                                    <Slider Grid.Column="1" Style="{StaticResource ConsoleFader}" Value="{Binding MixVolume}"
                                            ToolTip="Track volume (double-click: 0 dB)" MouseDoubleClick="Fader_MouseDoubleClick" />
                                    <local:LedMeter Grid.Column="2" Segments="30" RedSegments="5" Margin="0,13" Level="{Binding SignalLevel}" ToolTip="Track level" />
                                </Grid>
                                <StackPanel DockPanel.Dock="Bottom">
                                    <TextBlock Style="{StaticResource Legend}" Text="PAN" Margin="0,4,0,0" />
                                    <local:Knob Width="36" Height="36" Look="Console" IsCentred="True" Accent="#98999B" DefaultPosition="0.5"
                                                Position="{Binding PanPosition}">
                                        <local:Knob.ToolTip>
                                            <TextBlock>
                                                <Run Text="Pan: " /><Run Text="{Binding PanDisplay, Mode=OneWay}" />
                                                <LineBreak /><Run Text="Drag up or down; double-click to centre" />
                                            </TextBlock>
                                        </local:Knob.ToolTip>
                                    </local:Knob>
                                    <DockPanel Margin="10,-6,10,0">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Legend}" Text="R" FontSize="7" />
                                        <TextBlock Style="{StaticResource Legend}" Text="L" FontSize="7" HorizontalAlignment="Left" />
                                    </DockPanel>
                                    <Grid Margin="4,6,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="M" Tag="{Binding}" Click="Mute_Click" ToolTip="Mute">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ConsoleButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Background" Value="#E8463C" />
                                                            <Setter Property="Foreground" Value="#2A0806" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="2" Content="S" Tag="{Binding}" Click="Solo_Click" ToolTip="Solo">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ConsoleButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSolo}" Value="True">
                                                            <Setter Property="Background" Value="#F2C94C" />
                                                            <Setter Property="Foreground" Value="#2A2006" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <!-- The inserts grow up to ten effects' worth, the sends take the rest, so every bus has its knob. -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" MinHeight="40" MaxHeight="184" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" MinHeight="94" />
                                    </Grid.RowDefinitions>
                                    <Border Margin="4,0,4,0" Background="#151618" CornerRadius="2" BorderBrush="#595959" BorderThickness="0,0,1,1">
                                        <ItemsControl ItemsSource="{Binding Effects}" ItemTemplate="{StaticResource InsertTemplate}" Tag="{Binding}" />
                                    </Border>
                                    <StackPanel Grid.Row="1">
                                        <Button Style="{StaticResource ConsoleButton}" Content="FX" Margin="4,3,4,0" Tag="{Binding}" Click="Fx_Click"
                                                ToolTip="Open the track's effect rack, to add Sonator's or VST effects" />
                                        <TextBlock Style="{StaticResource Legend}" Text="SEND" Margin="0,6,0,1" />
                                    </StackPanel>
                                    <Grid Grid.Row="2">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemTemplate="{StaticResource SendTemplate}">
                                                <ItemsControl.ItemsSource>
                                                    <MultiBinding Converter="{StaticResource SendControls}">
                                                        <Binding />
                                                        <Binding Path="DataContext.Buses" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="DataContext.BusesVersion" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </ItemsControl.ItemsSource>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock Style="{StaticResource Legend}" FontWeight="Normal" FontSize="7" TextAlignment="Center" TextWrapping="Wrap"
                                                   Margin="4,10,4,0" VerticalAlignment="Top" IsHitTestVisible="False" Text="no buses: + BUS adds one">
                                            <TextBlock.Visibility>
                                                <Binding Path="DataContext.Buses.Count" RelativeSource="{RelativeSource AncestorType=Window}">
                                                    <Binding.Converter>
                                                        <local:ZeroToVisibleConverter />
                                                    </Binding.Converter>
                                                </Binding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The buses: what the tracks send to them runs through their effects and joins the mix. -->
            <ItemsControl ItemsSource="{Binding Buses}" Margin="4,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Module}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <Grid Margin="0,3,0,2">
                                        <ContentControl ContentTemplate="{StaticResource Screw}" Focusable="False" />
                                        <Button Style="{StaticResource ConsoleButton}" Content="✕" Width="13" Height="13" FontSize="7" HorizontalAlignment="Right" Margin="0,0,3,0"
                                                Tag="{Binding}" Click="RemoveBus_Click" ToolTip="Remove the bus, and the tracks' sends to it" />
                                    </Grid>
                                    <Border Height="5" Background="{Binding TrackColorBrush}" Margin="4,0" />
                                    <TextBlock Style="{StaticResource Legend}" Text="INSERT" Margin="0,4,0,1" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom">
                                    <Border Height="15" Margin="4,4,4,0" Background="#101113" CornerRadius="2">
                                        <TextBlock Text="{Binding VolumeDisplay}" FontFamily="Consolas" FontSize="8.5" Foreground="#FF8A3D"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <!-- The bus's name, on tape too: it can be written on. -->
                                    <TextBox Height="18" Margin="3,4,3,0" Background="#DCEFE9" BorderThickness="0" Padding="0"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontFamily="Segoe Print" FontSize="9" Foreground="#0F4A42"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="The bus's name: click to write it" />
                                    <ContentControl ContentTemplate="{StaticResource Screw}" Margin="0,4,0,3" Focusable="False" />
                                </StackPanel>
                                <Grid DockPanel.Dock="Bottom" Height="230" Margin="1,6,3,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="17" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="5" />
                                    </Grid.ColumnDefinitions>
                                    <local:FaderScale ThumbLength="26" />
                                    <Slider Grid.Column="1" Style="{StaticResource ConsoleFader}" Value="{Binding MixVolume}"
                                            ToolTip="Bus volume (double-click: 0 dB)" MouseDoubleClick="Fader_MouseDoubleClick" />
                                </Grid>
                                <StackPanel DockPanel.Dock="Bottom">
                                    <TextBlock Style="{StaticResource Legend}" Text="PAN" Margin="0,4,0,0" />
                                    <local:Knob Width="36" Height="36" Look="Console" IsCentred="True" Accent="#98999B" DefaultPosition="0.5"
                                                Position="{Binding PanPosition}" ToolTip="Pan: drag up or down; double-click to centre" />
                                    <DockPanel Margin="10,-6,10,0">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Legend}" Text="R" FontSize="7" />
                                        <TextBlock Style="{StaticResource Legend}" Text="L" FontSize="7" HorizontalAlignment="Left" />
                                    </DockPanel>
                                    <Button Margin="4,6,4,0" Content="M" Tag="{Binding}" Click="BusMute_Click" ToolTip="Mute the bus">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ConsoleButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Background" Value="#E8463C" />
                                                        <Setter Property="Foreground" Value="#2A0806" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <!-- The same rows as a track's strip, so the strips line up. -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" MinHeight="40" MaxHeight="184" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" MinHeight="94" />
                                    </Grid.RowDefinitions>
                                    <Border Margin="4,0,4,0" Background="#151618" CornerRadius="2" BorderBrush="#595959" BorderThickness="0,0,1,1">
                                        <ItemsControl ItemsSource="{Binding Effects}" ItemTemplate="{StaticResource InsertTemplate}" Tag="{Binding}" />
                                    </Border>
                                    <StackPanel Grid.Row="1">
                                        <Button Style="{StaticResource ConsoleButton}" Content="FX" Margin="4,3,4,0" Tag="{Binding}" Click="Fx_Click"
                                                ToolTip="Open the bus's effect rack" />
                                        <TextBlock Style="{StaticResource Legend}" Text="RETURN" Margin="0,6,0,1" />
                                    </StackPanel>
                                    <Border Grid.Row="2" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- An empty slot in the frame, where another bus goes. -->
            <Button Width="44" Margin="4,0,0,0" VerticalAlignment="Stretch" Click="AddBus_Click" Cursor="Hand" Focusable="False"
                    ToolTip="Add a bus (an effect return): tracks send part of their sound to it, as to a shared reverb">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Slot" Background="#1A1B1D" BorderBrush="#353535" BorderThickness="1" CornerRadius="2">
                            <TextBlock Text="+ BUS" Foreground="#959698" FontFamily="Arial" FontWeight="Bold" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Slot" Property="BorderBrush" Value="#959698" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
          </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
