<Window x:Class="Sonator.MixerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mixer"
        Width="960"
        Height="560"
        Background="#1B2330"
        Foreground="#C4CFDA"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#212D3A" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="BorderBrush" Value="#607A96" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="2" />
        </Style>
    </Window.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel x:Name="StripsPanel" Orientation="Horizontal" />
    </ScrollViewer>
</Window>
