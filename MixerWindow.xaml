<Window x:Class="Sonator.MixerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sonator"
        Title="Mixer"
        Width="1100"
        Height="620"
        MinHeight="460"
        Background="#151C26"
        Foreground="#C4CFDA"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <local:SendControlsConverter x:Key="SendControls" />

        <Style x:Key="StripButton" TargetType="Button">
            <Setter Property="Background" Value="#2A3948" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="#7EB2FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A tall fader: the track runs up the middle, the cap is the handle. -->
        <Style x:Key="FaderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="SmallChange" Value="0.01" />
            <Setter Property="LargeChange" Value="0.05" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Width="4" CornerRadius="2" Background="#0C1117" BorderBrush="#2E3F52" BorderThickness="1" HorizontalAlignment="Center" />
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Height="30" Width="34" Cursor="SizeNS">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" BorderBrush="#0C1117" BorderThickness="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#C9D3DD" Offset="0" />
                                                            <GradientStop Color="#8A97A5" Offset="0.48" />
                                                            <GradientStop Color="#E8EEF4" Offset="0.5" />
                                                            <GradientStop Color="#7C8896" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One effect in a strip's insert list: dimmed while it is off; a click opens the rack on it. -->
        <DataTemplate x:Key="InsertTemplate">
            <Border Margin="0,1" Padding="5,2" CornerRadius="3" Background="#22303F" BorderBrush="#34475C" BorderThickness="1"
                    Cursor="Hand" ToolTip="Open the rack on this effect" MouseLeftButtonUp="Insert_MouseLeftButtonUp">
                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#9FD3F2" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="Foreground" Value="#5D6E80" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPluginMissing}" Value="True">
                                    <Setter Property="Foreground" Value="#E6C45B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- The master strip, always at the right. -->
        <Border DockPanel.Dock="Right" Width="132" Margin="10,0,0,0" Padding="8" CornerRadius="6"
                Background="#1F2935" BorderBrush="#4F8F83" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="MASTER" FontWeight="Bold" FontSize="13" Foreground="#E8EEF4" HorizontalAlignment="Center" />
                <TextBlock DockPanel.Dock="Top" Text="INSERTS" FontSize="10" Foreground="#7F93A8" Margin="0,8,0,2" />
                <ItemsControl DockPanel.Dock="Top" Height="96" ItemsSource="{Binding MasterTrack.Effects}" ItemTemplate="{StaticResource InsertTemplate}"
                              Tag="{Binding MasterTrack}" />
                <Button DockPanel.Dock="Top" Style="{StaticResource StripButton}" Content="FX" Margin="0,4,0,0"
                        Tag="{Binding MasterTrack}" Click="Fx_Click" ToolTip="Open the master's effect rack: its effects run on the whole mix" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding MasterVolume, StringFormat={}{0:P0}}" HorizontalAlignment="Center"
                           FontWeight="Bold" Foreground="#E8EEF4" Margin="0,6,0,0" />
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                    </Grid.ColumnDefinitions>
                    <Slider Style="{StaticResource FaderStyle}" Value="{Binding MasterVolume}" ToolTip="Final mix volume" />
                    <local:LedMeter Grid.Column="1" Width="10" Segments="24" RedSegments="4" Level="{Binding MasterSignalLevel}" ToolTip="Master level" />
                </Grid>
            </DockPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding Tracks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- One track's channel strip, top to bottom as the sound goes: inserts, pan, fader, mute and solo. -->
                        <Border Width="120" Margin="0,0,6,0" CornerRadius="6" Background="#1F2935" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#34475C" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#E4ECF4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Height="6" CornerRadius="5,5,0,0" Background="{Binding TrackColorBrush}" />
                                <StackPanel DockPanel.Dock="Top" Margin="7,5,7,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#E8EEF4" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}" Cursor="Hand" MouseLeftButtonUp="TrackName_MouseLeftButtonUp" />
                                    <TextBlock Text="{Binding PluginAndSoundName}" FontSize="10" Foreground="#7F93A8" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding PluginAndSoundName}" Height="14" />
                                    <TextBlock Text="INSERTS" FontSize="10" Foreground="#7F93A8" Margin="0,6,0,2" />
                                    <ItemsControl Height="72" ItemsSource="{Binding Effects}" ItemTemplate="{StaticResource InsertTemplate}" Tag="{Binding}" />
                                    <Button Style="{StaticResource StripButton}" Content="FX" Margin="0,4,0,0" Tag="{Binding}" Click="Fx_Click"
                                            ToolTip="Open the track's effect rack, to add Sonator's or VST effects">
                                    </Button>
                                    <!-- How much of the track goes to each bus, after its fader. -->
                                    <TextBlock Text="SENDS" FontSize="10" Foreground="#7F93A8" Margin="0,8,0,2" />
                                    <Grid Height="78">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl>
                                            <ItemsControl.ItemsSource>
                                                <MultiBinding Converter="{StaticResource SendControls}">
                                                    <Binding />
                                                    <Binding Path="DataContext.Buses" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    <Binding Path="DataContext.BusesVersion" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                </MultiBinding>
                                            </ItemsControl.ItemsSource>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,4">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LevelDisplay}" FontSize="10" Foreground="#E8EEF4" />
                                                            <TextBlock Text="{Binding Bus.Name}" FontSize="10" Foreground="#62B7A4" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                        <local:VolumeBar Height="12" Margin="0,1,0,0" DefaultValue="0.75" Value="{Binding Level}"
                                                                         ToolTip="How much of the track goes to this bus. Double-click: 0 dB" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="no buses: + BUS adds one" FontSize="9" Foreground="#5D6E80" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.Buses.Count, RelativeSource={RelativeSource AncestorType=Window}}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    </Grid>

                                    <DockPanel Margin="0,10,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PanDisplay}" FontSize="10" Foreground="#E8EEF4" Width="28" TextAlignment="Right" />
                                        <TextBlock Text="PAN" FontSize="10" Foreground="#7F93A8" />
                                    </DockPanel>
                                    <local:VolumeBar Height="14" Margin="0,2,0,0" IsPan="True" DefaultValue="0" Value="{Binding MixPan}"
                                                     ToolTip="Pan: drag left or right, double-click to centre" />
                                </StackPanel>
                                <Grid DockPanel.Dock="Bottom" Margin="7,6,7,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="M" Tag="{Binding}" Click="Mute_Click" ToolTip="Mute">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource StripButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Background" Value="#49B88D" />
                                                        <Setter Property="Foreground" Value="#0F1A14" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="2" Content="S" Tag="{Binding}" Click="Solo_Click" ToolTip="Solo">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource StripButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSolo}" Value="True">
                                                        <Setter Property="Background" Value="#49B88D" />
                                                        <Setter Property="Foreground" Value="#0F1A14" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding VolumeDisplay}" HorizontalAlignment="Center" FontWeight="Bold"
                                           Foreground="#E8EEF4" Margin="0,4,0,0" />
                                <Grid Margin="7,10,7,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Style="{StaticResource FaderStyle}" Value="{Binding MixVolume}" ToolTip="Track volume (double-click: 0 dB)"
                                            MouseDoubleClick="Fader_MouseDoubleClick" />
                                    <local:LedMeter Grid.Column="1" Width="10" Segments="24" RedSegments="4" Level="{Binding SignalLevel}"
                                                    ToolTip="Track level" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The buses: what the tracks send to them runs through their effects and joins the mix. -->
            <ItemsControl ItemsSource="{Binding Buses}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="120" Margin="0,0,6,0" CornerRadius="6" Background="#1B2B2E" BorderBrush="#3F7F76" BorderThickness="1">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Height="6" CornerRadius="5,5,0,0" Background="{Binding TrackColorBrush}" />
                                <StackPanel DockPanel.Dock="Top" Margin="7,5,7,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource StripButton}" Content="✕" Width="20" Height="18"
                                                Tag="{Binding}" Click="RemoveBus_Click" ToolTip="Remove the bus, and the tracks' sends to it" />
                                        <TextBlock Text="BUS" FontSize="10" Foreground="#62B7A4" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" FontSize="12" Margin="0,2,0,0"
                                             Background="#14201F" Foreground="#E8EEF4" BorderBrush="#2F5F58" ToolTip="The bus's name" />
                                    <TextBlock Text="INSERTS" FontSize="10" Foreground="#7F93A8" Margin="0,8,0,2" />
                                    <ItemsControl Height="72" ItemsSource="{Binding Effects}" ItemTemplate="{StaticResource InsertTemplate}" Tag="{Binding}" />
                                    <Button Style="{StaticResource StripButton}" Content="FX" Margin="0,4,0,0" Tag="{Binding}" Click="Fx_Click"
                                            ToolTip="Open the bus's effect rack" />
                                    <Border Height="91" />
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PanDisplay}" FontSize="10" Foreground="#E8EEF4" Width="28" TextAlignment="Right" />
                                        <TextBlock Text="PAN" FontSize="10" Foreground="#7F93A8" />
                                    </DockPanel>
                                    <local:VolumeBar Height="14" Margin="0,2,0,0" IsPan="True" DefaultValue="0" Value="{Binding MixPan}"
                                                     ToolTip="Pan: drag left or right, double-click to centre" />
                                </StackPanel>
                                <Button DockPanel.Dock="Bottom" Margin="7,6,7,8" Content="M" Tag="{Binding}" Click="BusMute_Click" ToolTip="Mute the bus">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StripButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="Background" Value="#49B88D" />
                                                    <Setter Property="Foreground" Value="#0F1A14" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding VolumeDisplay}" HorizontalAlignment="Center" FontWeight="Bold"
                                           Foreground="#E8EEF4" Margin="0,4,0,0" />
                                <Grid Margin="7,10,7,0">
                                    <Slider Style="{StaticResource FaderStyle}" Value="{Binding MixVolume}" ToolTip="Bus volume (double-click: 0 dB)"
                                            MouseDoubleClick="Fader_MouseDoubleClick" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource StripButton}" Content="+ BUS" Width="70" Height="28" VerticalAlignment="Top" Margin="2,0,0,0"
                    Click="AddBus_Click" ToolTip="Add a bus (an effect return): tracks send part of their sound to it, as to a shared reverb" />
          </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
