<Window x:Class="Sonator.VstPluginEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VST Plug-in"
        Width="440"
        SizeToContent="Height"
        MaxHeight="720"
        Background="#1B2330"
        Foreground="#C4CFDA"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#212D3A" />
            <Setter Property="Foreground" Value="#1B2330" />
            <Setter Property="BorderBrush" Value="#607A96" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A3948" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#354D69" />
                    <Setter Property="BorderBrush" Value="#7EB2FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="#2A3948" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#7AA6D8" />
                    <Setter Property="Foreground" Value="#1B2330" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <Border Width="36"
                    Height="36"
                    CornerRadius="4"
                    Background="#1F3D66"
                    BorderBrush="#7AA6D8"
                    BorderThickness="1"
                    Margin="0,0,10,0">
                <TextBlock x:Name="BadgeText"
                           Text="V3"
                           FontWeight="Bold"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#7AA6D8" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PluginNameText" Text="Plugin name" FontWeight="Bold" FontSize="15" />
                <TextBlock x:Name="PluginKindText" Text="VST3" FontSize="10" Foreground="#8FA3B8" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1"
                    x:Name="PluginPathText"
                    Text="C:\path\to\plugin.vst3"
                    FontSize="10"
                    Foreground="#8FA3B8"
                    TextWrapping="Wrap"
                    Margin="0,0,0,10" />

        <TextBlock Grid.Row="2"
                    x:Name="StatusText"
                    Text="Loading VST3 module..."
                    FontSize="10"
                    Foreground="#8FA3B8"
                    TextWrapping="Wrap"
                    Margin="0,0,0,10" />

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Preset" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" SelectedIndex="0">
                <ComboBoxItem Content="Init" />
                <ComboBoxItem Content="Lead" />
                <ComboBoxItem Content="Pad" />
                <ComboBoxItem Content="Bass" />
            </ComboBox>
        </Grid>

        <GroupBox Grid.Row="4" Header="REAL PARAMETERS">
            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ParametersPanel" Margin="4" />
            </ScrollViewer>
        </GroupBox>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OpenNativeEditorButton"
                    Content="Open native editor"
                    Width="220"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="OpenNativeEditorButton_Click" />
            <Button Content="Close" Width="90" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
