<Window x:Class="Sonator.VstPluginEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VST Plug-in"
        Width="440"
        SizeToContent="Height"
        MaxHeight="720"
        Background="#2D2D2D"
        Foreground="#D2D3D5"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#414141" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#575757" />
                    <Setter Property="BorderBrush" Value="#7EB2FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="#414141" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#7AA6D8" />
                    <Setter Property="Foreground" Value="#2D2D2D" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <Border Width="36"
                    Height="36"
                    CornerRadius="4"
                    Background="#1F3D66"
                    BorderBrush="#7AA6D8"
                    BorderThickness="1"
                    Margin="0,0,10,0">
                <TextBlock x:Name="BadgeText"
                           Text="V3"
                           FontWeight="Bold"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#7AA6D8" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PluginNameText" Text="Plugin name" FontWeight="Bold" FontSize="15" />
                <TextBlock x:Name="PluginKindText" Text="VST3" FontSize="10" Foreground="#A8A9AB" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1"
                    x:Name="PluginPathText"
                    Text="C:\path\to\plugin.vst3"
                    FontSize="10"
                    Foreground="#A8A9AB"
                    TextWrapping="Wrap"
                    Margin="0,0,0,10" />

        <TextBlock Grid.Row="2"
                    x:Name="StatusText"
                    Text="Loading VST3 module..."
                    FontSize="10"
                    Foreground="#A8A9AB"
                    TextWrapping="Wrap"
                    Margin="0,0,0,10" />

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Preset" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" SelectedIndex="0">
                <ComboBoxItem Content="Init" />
                <ComboBoxItem Content="Lead" />
                <ComboBoxItem Content="Pad" />
                <ComboBoxItem Content="Bass" />
            </ComboBox>
        </Grid>

        <GroupBox Grid.Row="4" Header="REAL PARAMETERS">
            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ParametersPanel" Margin="4" />
            </ScrollViewer>
        </GroupBox>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OpenNativeEditorButton"
                    Content="Open native editor"
                    Width="220"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="OpenNativeEditorButton_Click" />
            <Button x:Name="MeasureLatencyButton"
                    Content="Measure latency"
                    Width="160"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="MeasureLatencyButton_Click" />
            <Button Content="Close" Width="90" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
