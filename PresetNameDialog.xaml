<Window x:Class="Sonator.PresetNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save preset"
        Width="440"
        SizeToContent="Height"
        Background="#28292B"
        Foreground="#D2D3D5"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3D3E40" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555658" />
                    <Setter Property="BorderBrush" Value="#7EB2FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16,14">
        <TextBlock Text="{Binding Heading}" FontFamily="Segoe UI Semibold" FontSize="15" Foreground="#EFF0F2" Margin="0,0,0,10" />
        <TextBlock Text="Preset name" FontSize="11" Foreground="#B9BABC" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox"
                 Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"
                 Background="#303133"
                 Foreground="#EFF0F2"
                 BorderBrush="#607A96"
                 BorderThickness="1"
                 Padding="6,4"
                 FontFamily="Consolas"
                 FontSize="13"
                 AutomationProperties.Name="PRESET NAME" />
        <TextBlock Text="{Binding Message}" Foreground="#D98A8A" TextWrapping="Wrap" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="CANCEL" Width="92" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="SAVE" Width="92" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
