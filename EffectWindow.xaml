<Window x:Class="Sonator.EffectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sonator"
        Title="{Binding WindowTitle}"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        Background="#1B2330"
        Foreground="#C4CFDA"
        FontFamily="Consolas"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="EffectButton" TargetType="ButtonBase">
            <Setter Property="Background" Value="#2A3948" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#354D69" />
                                <Setter TargetName="Body" Property="BorderBrush" Value="#7EB2FF" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#2D745D" />
                                <Setter TargetName="Body" Property="BorderBrush" Value="#5FB87B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16,12,16,14">
        <!-- The effect's name, what it is, its on switch, and its meter when it has one. -->
        <DockPanel Margin="0,0,0,12">
            <ToggleButton DockPanel.Dock="Right"
                          Style="{StaticResource EffectButton}"
                          Width="54"
                          IsChecked="{Binding TrackEffect.IsEnabled}"
                          Content="ON"
                          AutomationProperties.Name="EFFECT ON"
                          ToolTip="Switch the effect on or off" />
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource EffectButton}"
                    Margin="0,0,8,0"
                    Content="RESET"
                    Click="Reset_Click"
                    ToolTip="Put every knob back to its default" />
            <StackPanel>
                <TextBlock Text="{Binding TrackEffect.Name}" FontFamily="Segoe UI Semibold" FontSize="20" Foreground="#E8EEF4" />
                <TextBlock Text="{Binding Subtitle}" Foreground="#7F93A8" FontSize="11" />
            </StackPanel>
        </DockPanel>

        <ItemsControl ItemsSource="{Binding TrackEffect.Parameters}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel MaxWidth="560" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="84" Margin="3" Padding="4,6" CornerRadius="6" Background="#212D3A" BorderBrush="#2E3F52" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="11" Foreground="#9FB4C9" />
                            <Grid Height="56" Margin="0,4">
                                <local:Knob Width="52" Height="52"
                                            Position="{Binding Position}"
                                            DefaultPosition="{Binding DefaultPosition}"
                                            Accent="#5CAFD6"
                                            AutomationProperties.Name="{Binding Name}"
                                            ToolTip="Drag up or down (Shift for fine), mouse wheel, double-click for the default">
                                    <local:Knob.Style>
                                        <Style TargetType="local:Knob">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Definition.IsSwitch}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </local:Knob.Style>
                                </local:Knob>
                                <ToggleButton Width="60"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsOn}"
                                              Content="{Binding DisplayValue}"
                                              AutomationProperties.Name="{Binding Name}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource EffectButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Definition.IsSwitch}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </Grid>
                            <TextBlock Text="{Binding DisplayValue}" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#E8EEF4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Definition.IsSwitch}" Value="True">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Gain reduction, for the compressor and the limiter. -->
        <StackPanel Margin="3,12,3,0" Visibility="{Binding MeterVisibility}">
            <DockPanel>
                <TextBlock Text="GAIN REDUCTION" FontSize="11" Foreground="#9FB4C9" />
                <TextBlock Text="{Binding MeterText}" HorizontalAlignment="Right" FontWeight="Bold" />
            </DockPanel>
            <ProgressBar Height="8" Margin="0,4,0,0" Minimum="0" Maximum="24" Value="{Binding MeterValue, Mode=OneWay}"
                         Background="#16202B" BorderBrush="#3A4D63" Foreground="#E6C45B" />
        </StackPanel>
    </StackPanel>
</Window>
