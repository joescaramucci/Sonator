<Window x:Class="Sonator.DriverSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASIO driver settings"
        Width="480"
        Height="340"
        Background="#28292B"
        Foreground="#D2D3D5"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#303133" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#607A96" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="DriverNameText" FontWeight="Bold" Grid.Row="0" />
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,4,0,12" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="Buffer size (samples)" />
            <ComboBox x:Name="BufferCombo" />
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="Sample rate" />
            <ComboBox x:Name="RateCombo" />
        </StackPanel>

        <TextBlock Grid.Row="4"
                   Text="Changes apply the next time audio starts. The driver can be used by one session at a time, so stop audio before reading or changing its settings."
                   FontSize="11" Opacity="0.8" />

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Driver control panel..." Click="ControlPanel_Click" />
            <Button x:Name="OkButton" Grid.Column="2" Content="OK" Click="Ok_Click" IsDefault="True" />
            <Button Grid.Column="3" Content="Cancel" Click="Cancel_Click" IsCancel="True" Margin="0" />
        </Grid>
    </Grid>
</Window>
