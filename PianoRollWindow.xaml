<Window x:Class="Sonator.PianoRollWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Piano roll"
        Width="1060"
        Height="640"
        Background="#2D2D2D"
        Foreground="#D2D3D5"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Focusable="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="#414141" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#575757" />
                    <Setter Property="BorderBrush" Value="#7EB2FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#3D3D3D" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#757678" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,4,4,4" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontFamily" Value="Consolas" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Background" Value="#333333" />
                        <Setter Property="Foreground" Value="#D2D3D5" />
                        <Setter Property="Padding" Value="6,3" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#595959" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2D745D" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid><Border CornerRadius="4" Background="{StaticResource Bevel.CastShadow}" Margin="0,1,0,-2" /><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Bevel.Outline}" BorderThickness="1" CornerRadius="4" /><Border CornerRadius="3" Margin="1" Background="{StaticResource Bevel.Sheen}" /><Border CornerRadius="3" Margin="1" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Bevel.Rim}" /><Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#D2D3D5" /></Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Body" Property="Background" Value="#515151" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Body" Property="Background" Value="#515151" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Margin="0,2,0,0"
                                        Background="#333333"
                                        BorderBrush="#757678"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetronomeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#414141" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#49B88D" />
                    <Setter Property="Foreground" Value="#0F1A14" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,6,10,0">
            <Button Content="PLAY" Width="70" Margin="0,0,6,0" Click="PlayButton_Click" />
            <Button Content="STOP" Width="70" Click="StopButton_Click" />
            <ToggleButton x:Name="DrumMapToggle" Content="DRUM MAP" Width="80" Height="26" Margin="20,0,0,0"
                          Style="{StaticResource MetronomeToggleStyle}" Click="DrumMapToggle_Click" />
            <TextBlock Margin="28,0,8,0" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="QUANTIZE" />
            <ComboBox x:Name="QuantizeGridBox" Width="130" Height="26" DisplayMemberPath="Label"
                      ToolTip="Grid the notes move to: straight, dotted or triplet values" />
            <ComboBox x:Name="QuantizeStrengthBox" Width="80" Height="26" Margin="6,0,0,0" DisplayMemberPath="Label"
                      ToolTip="Strength: how far each note moves toward the grid" />
            <ComboBox x:Name="QuantizeSwingBox" Width="110" Height="26" Margin="6,0,0,0" DisplayMemberPath="Label"
                      ToolTip="Swing: delays every second grid point; 100% is a triplet shuffle" />
            <ToggleButton x:Name="QuantizeEndsToggle" Content="ENDS" Width="56" Height="26" Margin="6,0,0,0"
                          Style="{StaticResource MetronomeToggleStyle}"
                          ToolTip="Also move where notes end. Off keeps each note's length" />
            <Button Content="APPLY" Width="70" Margin="6,0,0,0" Click="QuantizeButton_Click"
                    ToolTip="Quantize all the notes of this track. Undo reverts it" />
        </StackPanel>
        <ScrollViewer x:Name="PianoRollScroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="PianoRollCanvas" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseLeftButtonDown="OnCanvasMouseDown"
                    MouseMove="OnCanvasMouseMove"
                    MouseLeftButtonUp="OnCanvasMouseUp"
                    MouseRightButtonDown="OnCanvasRightMouseDown" />
        </ScrollViewer>
    </Grid>
</Window>
