<Window x:Class="Sonator.PianoRollWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Piano roll"
        Width="960"
        Height="640"
        Background="#1B2330"
        Foreground="#C4CFDA"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Focusable="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="PianoRollCanvas" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseLeftButtonDown="OnCanvasMouseDown"
                    MouseMove="OnCanvasMouseMove"
                    MouseLeftButtonUp="OnCanvasMouseUp"
                    MouseRightButtonDown="OnCanvasRightMouseDown" />
        </ScrollViewer>
        <TextBlock Grid.Row="1" Margin="10,4,10,6" FontSize="11" Opacity="0.85" TextWrapping="Wrap"
                   Text="Click an empty cell to add a note. Drag a note to move it. Right-click or press Delete to remove it. Drag in the lane at the bottom to set velocity." />
    </Grid>
</Window>
