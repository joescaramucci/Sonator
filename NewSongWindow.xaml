<Window x:Class="Sonator.NewSongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sonator"
        Title="New song"
        Width="1200"
        Height="780"
        MinWidth="820"
        MinHeight="520"
        Background="#2D2D2D"
        Foreground="#D2D3D5"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#414141" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#575757" />
                    <Setter Property="BorderBrush" Value="#7EB2FF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#3D3D3D" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#9A5A1E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A suggested sound: a tile with its name and where it comes from; the one chosen for its part is lit. -->
        <Style x:Key="SoundTile" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tile" Background="#333333" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="4" Padding="8,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#3D3D3D" />
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#7EB2FF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#2F5A7A" />
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#E6C45B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Toggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#414141" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#49B88D" />
                    <Setter Property="Foreground" Value="#0F1A14" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="NEW SONG" FontFamily="Segoe UI Semibold" FontSize="20" Foreground="#EFF0F2" />
                <TextBlock Text="What kind of music do you want to make? Each part gets sounds that suit it: hear them, choose one, and the song starts with them."
                           Foreground="#98999B" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="CreateButton" DockPanel.Dock="Right" Content="CREATE SONG" Width="150" IsDefault="True" IsEnabled="False" Click="CreateButton_Click"
                    ToolTip="A new project at the tempo shown, with a track for each part ticked, playing the sound chosen for it" />
            <Button DockPanel.Dock="Right" Content="CANCEL" Width="100" Margin="0,0,8,0" IsCancel="True" Click="CancelButton_Click" />
            <Button DockPanel.Dock="Right" Content="EMPTY PROJECT" Width="140" Margin="0,0,8,0" Click="EmptyButton_Click"
                    ToolTip="A new project with eight empty tracks, as before: no style, no sounds" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#B9BABC" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#292929" BorderBrush="#474747" BorderThickness="1" CornerRadius="5">
                <ListBox x:Name="StyleList"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="4"
                         ItemContainerStyle="{StaticResource DarkRow}"
                         SelectionChanged="StyleList_SelectionChanged"
                         AutomationProperties.Name="STYLES">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Tempo, StringFormat={}{0} BPM}" Foreground="#98999B" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Background="#292929" BorderBrush="#474747" BorderThickness="1" CornerRadius="5">
                <DockPanel Margin="12,10">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="TEMPO" FontWeight="Bold" Foreground="#ACADAF" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="TempoBox" Width="54" Height="26" FontSize="14" Background="#1A1B1D" Foreground="#EFF0F2" CaretBrush="#EFF0F2"
                                     BorderBrush="#6C6C6C" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     AutomationProperties.Name="TEMPO" />
                            <TextBlock Text="BPM" Foreground="#98999B" VerticalAlignment="Center" Margin="6,0,14,0" />
                            <ToggleButton x:Name="AutoPreviewToggle" Content="AUTO" IsChecked="True" Width="60" Style="{StaticResource Toggle}"
                                          ToolTip="Hear each sound as it is clicked" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="StyleTitle" FontFamily="Segoe UI Semibold" FontSize="18" Foreground="#EFF0F2" />
                            <TextBlock x:Name="StyleDescription" Foreground="#B9BABC" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock x:Name="StyleHits" Foreground="#E6C45B" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PartsPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
