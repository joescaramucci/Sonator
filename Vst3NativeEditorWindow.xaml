<Window x:Class="Sonator.Vst3NativeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VST3 Native GUI"
        Width="440"
        Height="320"
        MinWidth="200"
        MinHeight="150"
        Background="#28292B"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Manual"
        ShowInTaskbar="False">
    <Grid>
        <ContentControl x:Name="EditorHostContainer" />
        <TextBlock x:Name="FallbackText"
                   Foreground="#D2D3D5"
                   FontFamily="Consolas"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="16"
                   Visibility="Collapsed" />
    </Grid>
</Window>
