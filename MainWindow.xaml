<Window x:Class="Sonator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sonator"
        xmlns:models="clr-namespace:Sonator.Models"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/sonator.ico"
        Width="1400"
        Height="860"
        WindowState="Maximized"
        
        Background="#DDE7F2"
        Foreground="#FF263241"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Paper" Color="#1B2330" />
        <SolidColorBrush x:Key="PaperHigh" Color="#212D3A" />
        <SolidColorBrush x:Key="Ink" Color="#BCC9D8" />
        <SolidColorBrush x:Key="Line" Color="#586E86" />
        <SolidColorBrush x:Key="Shade" Color="#2B3949" />
        <SolidColorBrush x:Key="DarkShade" Color="#3A4F68" />
        <SolidColorBrush x:Key="Accent" Color="#7AA6D8" />
        <SolidColorBrush x:Key="AccentSoft" Color="#1F3D66" />
        <SolidColorBrush x:Key="Success" Color="#49B88D" />
        <local:SignalPeakVisibilityConverter x:Key="SignalPeakVisibilityConverter" />
        <local:MeterSegmentBrushConverter x:Key="MeterSegmentBrushConverter" />
        <local:MasterMeterSegmentBrushConverter x:Key="MasterMeterSegmentBrushConverter" />
        <local:VolumePercentConverter x:Key="VolumePercentConverter" />
        <local:AudioClipWidthConverter x:Key="AudioClipWidthConverter" />
        <local:StepOffsetConverter x:Key="StepOffsetConverter" />

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#263545" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="BorderBrush" Value="#586E86" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,4,4,4" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontFamily" Value="Consolas" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Background" Value="#1F2A38" />
                        <Setter Property="Foreground" Value="#C4CFDA" />
                        <Setter Property="Padding" Value="6,3" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#3A4F68" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2D745D" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Body"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5">
                                            <Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#C4CFDA" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Body" Property="Background" Value="#2F4A63" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Body" Property="Background" Value="#2F4A63" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Margin="0,2,0,0"
                                        Background="#1F2A38"
                                        BorderBrush="#586E86"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetronomeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2A3948" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#49B88D" />
                                <Setter Property="Foreground" Value="#0F1A14" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The recessed dark panel and glowing digits of the position clocks in the top bar. -->
        <Style x:Key="ClockPanel" TargetType="Border">
            <Setter Property="Background" Value="#0C1219" />
            <Setter Property="BorderBrush" Value="#2E3F52" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style x:Key="ClockDigits" TargetType="local:SevenSegmentDisplay">
            <Setter Property="DigitHeight" Value="26" />
            <Setter Property="Foreground" Value="#7FF0C2" />
            <Setter Property="GhostBrush" Value="#132A26" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#3FE0A0" BlurRadius="9" ShadowDepth="0" Opacity="0.55" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BottomTabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#3A4F68" />
            <Setter Property="BorderBrush" Value="#6F87A0" />
            <Setter Property="Foreground" Value="#E4ECF4" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#1B2330" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Foreground" Value="#C4CFDA" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#8A93A0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="#2A3948" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#354D69" />
                    <Setter Property="BorderBrush" Value="#7EB2FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TrackRecordArmButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#3E536B" />
            <Setter Property="BorderBrush" Value="#6F87A0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#BCC9D8" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#8DA8C2" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#D94C4C" />
                    <Setter Property="BorderBrush" Value="#A62B2B" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Background" Value="#212D3A" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="BorderBrush" Value="#607A96" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseWheel" Handler="EditableTextBox_PreviewMouseWheel" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#27374A" />
                    <Setter Property="BorderBrush" Value="#7EB2FF" />
                </Trigger>
                <Trigger Property="IsReadOnly" Value="False">
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="BorderBrush" Value="#485B72" />
            <Setter Property="Background" Value="#212D3A" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <Grid Background="{Binding SourceTrack.TrackColorBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="#2C3B4D"
                                        BorderBrush="#5A728D"
                                        BorderThickness="0,0,0,1"
                                        Padding="7,3"
                                        CornerRadius="7,7,0,0">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                </Border>
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MasterLevelMeterStyle" TargetType="ProgressBar">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="132" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Background" Value="#111922" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#2F3D4D"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=11}" />
                                <Border Grid.Row="1" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=10}" />
                                <Border Grid.Row="2" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=9}" />
                                <Border Grid.Row="3" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=8}" />
                                <Border Grid.Row="4" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=7}" />
                                <Border Grid.Row="5" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=6}" />
                                <Border Grid.Row="6" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=5}" />
                                <Border Grid.Row="7" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=4}" />
                                <Border Grid.Row="8" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=3}" />
                                <Border Grid.Row="9" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=2}" />
                                <Border Grid.Row="10" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=1}" />
                                <Border Grid.Row="11" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=0}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VerticalMeter" TargetType="ProgressBar">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="#52C7A1" />
            <Setter Property="Background" Value="#1A2430" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <RotateTransform Angle="-90" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MasterMixSliderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="132" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Border Background="#1F2933"
                                BorderBrush="#667A8F"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="2">
                            <Grid>
                                <Border Background="#151D26"
                                        CornerRadius="2"
                                        Margin="6,5,6,5" />
                                <Track x:Name="PART_Track"
                                       Orientation="Vertical">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Background="#3F9FD6"
                                                      BorderBrush="#3F9FD6"
                                                      BorderThickness="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Background="#34414E"
                                                      BorderBrush="#34414E"
                                                      BorderThickness="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="18"
                                               Height="12"
                                               Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border BorderBrush="#8EA9C7"
                                                            BorderThickness="1"
                                                            CornerRadius="2">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#F5F8FB" Offset="0" />
                                                                <GradientStop Color="#C7D0DA" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SongTimelineSliderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Border Background="#1F2C3A"
                                BorderBrush="#6F869C"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4,2">
                            <Grid Background="#1F2C3A">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Background="#41AF8B"
                                                      BorderBrush="#41AF8B"
                                                      BorderThickness="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Background="#425A72"
                                                      BorderBrush="#425A72"
                                                      BorderThickness="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="12" Height="22" Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#BEC9D5"
                                                            BorderBrush="#8EA9C7"
                                                            BorderThickness="1"
                                                            CornerRadius="4" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Paper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#34475C" BorderBrush="#5D7A98" BorderThickness="0,0,0,1" Padding="5,4" MinHeight="42">
            <Grid>
                <Image Source="pack://application:,,,/Assets/sonator-logo-22.png"
                       Width="22" Height="22"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="0,4,0,0"
                       ToolTip="Sonator" />
                <Menu Margin="30,0,0,0" HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Background="#2A3948"
                      Foreground="#C4CFDA"
                      BorderBrush="#5C7A99"
                      BorderThickness="1"
                      FontFamily="Segoe UI Semibold"
                      FontSize="12">
                    <MenuItem Header="_File" SubmenuOpened="FileMenu_SubmenuOpened">
                        <MenuItem Header="_New project" Click="NewProjectMenuItem_Click" InputGestureText="Ctrl+N" />
                        <MenuItem Header="_Open project..." Click="OpenProjectMenuItem_Click" InputGestureText="Ctrl+L" />
                        <MenuItem x:Name="OpenRecentMenuItem" Header="Open _recent" />
                        <Separator />
                        <MenuItem Header="_Save project" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S" />
                        <MenuItem Header="Save _As..." Command="{Binding SaveProjectAsCommand}" InputGestureText="Ctrl+Shift+S" />
                        <Separator />
                        <MenuItem Header="Import _MIDI..." Command="{Binding ImportMidiCommand}" />
                        <MenuItem Header="Close _project" Click="CloseProjectMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="_Exit" Click="CloseMenuItem_Click" InputGestureText="Alt+F4" />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                        <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                        <Separator />
                        <MenuItem Header="Copy _track" Command="{Binding CopyTrackCommand}" />
                        <MenuItem Header="Incolla tr_ack" Command="{Binding PasteTrackCommand}" />
                        <MenuItem Header="Cancella cella arrange" Command="{Binding ClearArrangeCellCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Functions">
                        <MenuItem Header="_Start" Command="{Binding PlayCommand}" />
                        <MenuItem Header="S_top" Command="{Binding StopCommand}" />
                        <MenuItem Header="_Record arm" IsEnabled="False" ToolTip="Recording is not implemented yet" Command="{Binding ToggleRecordCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Arrange">
                        <MenuItem Header="Create arrange pattern" Command="{Binding CreateArrangePatternCommand}" />
                        <MenuItem Header="Copy arrange pattern" Command="{Binding CopyArrangePatternCommand}" />
                        <Separator />
                        <MenuItem Header="Move pattern up" Command="{Binding MoveArrangePatternUpCommand}" />
                        <MenuItem Header="Move pattern down" Command="{Binding MoveArrangePatternDownCommand}" />
                        <MenuItem Header="Delete arrange pattern" Command="{Binding DeleteArrangePatternCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Track">
