<Window x:Class="Sonator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sonator"
        xmlns:models="clr-namespace:Sonator.Models"
        xmlns:vm="clr-namespace:Sonator.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/sonator.ico"
        Width="1400"
        Height="860"
        WindowState="Maximized"
        
        Background="#EAEBED"
        Foreground="#FF3B3B3B"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Paper" Color="#2D2D2D" />
        <SolidColorBrush x:Key="PaperHigh" Color="#353535" />
        <SolidColorBrush x:Key="Ink" Color="#CDCED0" />
        <!-- The edge of the boxes on the panels: they read as sunk in, dark where the light does not reach and lit below. -->
        <LinearGradientBrush x:Key="Line" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#101113" Offset="0" />
            <GradientStop Color="#3B3B3B" Offset="0.5" />
            <GradientStop Color="#707070" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Shade" Color="#424242" />
        <SolidColorBrush x:Key="DarkShade" Color="#595959" />
        <SolidColorBrush x:Key="Accent" Color="#7AA6D8" />
        <SolidColorBrush x:Key="AccentSoft" Color="#1F3D66" />
        <SolidColorBrush x:Key="Success" Color="#49B88D" />
        <local:SignalPeakVisibilityConverter x:Key="SignalPeakVisibilityConverter" />
        <local:MeterSegmentBrushConverter x:Key="MeterSegmentBrushConverter" />
        <local:MasterMeterSegmentBrushConverter x:Key="MasterMeterSegmentBrushConverter" />
        <local:VolumePercentConverter x:Key="VolumePercentConverter" />
        <local:AudioClipWidthConverter x:Key="AudioClipWidthConverter" />
        <BooleanToVisibilityConverter x:Key="VisibleWhenLoopRange" />
        <local:StepOffsetConverter x:Key="StepOffsetConverter" />
        <local:RulerBarLabelConverter x:Key="RulerBarLabelConverter" />

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#3D3D3D" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#757678" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,4,4,4" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontFamily" Value="Consolas" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Background" Value="#333333" />
                        <Setter Property="Foreground" Value="#D2D3D5" />
                        <Setter Property="Padding" Value="6,3" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#595959" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2D745D" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <Border CornerRadius="4" Background="{StaticResource Bevel.CastShadow}" Margin="0,1,0,-2" />
                                            <Border x:Name="Body"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{StaticResource Bevel.Outline}"
                                                    BorderThickness="1"
                                                    CornerRadius="4" />
                                            <Border CornerRadius="3" Margin="1" Background="{StaticResource Bevel.Sheen}" />
                                            <Border x:Name="Rim" CornerRadius="3" Margin="1" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Bevel.Rim}" />
                                            <Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#D2D3D5" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Body" Property="Background" Value="#515151" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Body" Property="Background" Value="#515151" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Margin="0,2,0,0"
                                        Background="#333333"
                                        BorderBrush="#757678"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A bay of the top bar: a shallow recess in the panel that a control or a display sits in. -->
        <Style x:Key="BarCell" TargetType="Border">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Inset.Edge}" />
            <Setter Property="Background" Value="#272727" />
        </Style>

        <Style x:Key="MetronomeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#414141" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#49B88D" />
                    <Setter Property="Foreground" Value="#0F1A14" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The recessed dark panel and glowing digits of the position clocks in the top bar. -->
        <Style x:Key="ClockPanel" TargetType="Border">
            <Setter Property="Background" Value="#141517" />
            <Setter Property="BorderBrush" Value="#474747" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style x:Key="ClockDigits" TargetType="local:SevenSegmentDisplay">
            <Setter Property="DigitHeight" Value="26" />
            <Setter Property="Foreground" Value="#7FF0C2" />
            <Setter Property="GhostBrush" Value="#132A26" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#3FE0A0" BlurRadius="9" ShadowDepth="0" Opacity="0.55" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BottomTabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#595959" />
            <Setter Property="BorderBrush" Value="#6F87A0" />
            <Setter Property="Foreground" Value="#EEEFF1" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#2D2D2D" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Foreground" Value="#D2D3D5" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#98999B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="#414141" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
        </Style>

        <Style x:Key="TrackRecordArmButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#5C5C5C" />
            <Setter Property="BorderBrush" Value="#6F87A0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#CDCED0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#AEAFB1" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#D94C4C" />
                    <Setter Property="BorderBrush" Value="#A62B2B" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Background" Value="#353535" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#607A96" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- Sunk into the panel: shadowed along its top, lit along its bottom edge. -->
                        <Border x:Name="Edge" Background="{StaticResource Inset.Face}" BorderBrush="{StaticResource Inset.Edge}"
                                BorderThickness="1" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Edge" Property="BorderBrush" Value="#7EB2FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Edge" Property="BorderBrush" Value="#7EB2FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseWheel" Handler="EditableTextBox_PreviewMouseWheel" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#414141" />
                    <Setter Property="BorderBrush" Value="#7EB2FF" />
                </Trigger>
                <Trigger Property="IsReadOnly" Value="False">
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="BorderBrush" Value="#636363" />
            <Setter Property="Background" Value="#353535" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <!-- A hardware module: a dark outline, a lit inner edge, an engraved title strip. -->
                        <Border BorderBrush="{StaticResource Bevel.Outline}"
                                BorderThickness="1"
                                Background="{StaticResource Panel.Face}"
                                CornerRadius="6">
                            <Border BorderBrush="#2EFFFFFF" BorderThickness="1,1,0,0" CornerRadius="5">
                                <Grid Background="{Binding SourceTrack.TrackColorBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Background="{StaticResource Panel.Header}"
                                            BorderBrush="#090A0C"
                                            BorderThickness="0,0,0,1"
                                            Padding="7,3"
                                            CornerRadius="5,5,0,0">
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True">
                                            <ContentPresenter.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="1" Direction="270" Opacity="0.8" />
                                            </ContentPresenter.Effect>
                                        </ContentPresenter>
                                    </Border>
                                    <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                                </Grid>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MasterLevelMeterStyle" TargetType="ProgressBar">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="132" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Background" Value="#222222" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#454545"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=11}" />
                                <Border Grid.Row="1" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=10}" />
                                <Border Grid.Row="2" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=9}" />
                                <Border Grid.Row="3" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=8}" />
                                <Border Grid.Row="4" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=7}" />
                                <Border Grid.Row="5" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=6}" />
                                <Border Grid.Row="6" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=5}" />
                                <Border Grid.Row="7" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=4}" />
                                <Border Grid.Row="8" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=3}" />
                                <Border Grid.Row="9" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=2}" />
                                <Border Grid.Row="10" Margin="0,0,0,1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=1}" />
                                <Border Grid.Row="11" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={StaticResource MasterMeterSegmentBrushConverter}, ConverterParameter=0}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VerticalMeter" TargetType="ProgressBar">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="#52C7A1" />
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <RotateTransform Angle="-90" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MasterMixSliderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="132" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Border Background="#303030"
                                BorderBrush="#7F8082"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="2">
                            <Grid>
                                <Border Background="#262626"
                                        CornerRadius="2"
                                        Margin="6,5,6,5" />
                                <Track x:Name="PART_Track"
                                       Orientation="Vertical">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Background="#3F9FD6"
                                                      BorderBrush="#3F9FD6"
                                                      BorderThickness="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Background="#474747"
                                                      BorderBrush="#474747"
                                                      BorderThickness="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="18"
                                               Height="12"
                                               Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border BorderBrush="#B1B2B4"
                                                            BorderThickness="1"
                                                            CornerRadius="2">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#F5F8FB" Offset="0" />
                                                                <GradientStop Color="#D3D4D6" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SongTimelineSliderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Border Background="#353535"
                                BorderBrush="#8B8C8E"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4,2">
                            <Grid Background="#353535">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Background="#41AF8B"
                                                      BorderBrush="#41AF8B"
                                                      BorderThickness="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Background="#616161"
                                                      BorderBrush="#616161"
                                                      BorderThickness="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="12" Height="22" Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#CCCDCF"
                                                            BorderBrush="#B1B2B4"
                                                            BorderThickness="1"
                                                            CornerRadius="4" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Paper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#4F4F4F" BorderBrush="#5D7A98" BorderThickness="0,0,0,1" Padding="5,4" MinHeight="42">
            <Grid>
                <Image Source="pack://application:,,,/Assets/sonator-logo-22.png"
                       Width="22" Height="22"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="0,4,0,0"
                       ToolTip="Sonator" />
                <Menu Margin="30,0,0,0" HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Background="#414141"
                      Foreground="#D2D3D5"
                      BorderBrush="#5C7A99"
                      BorderThickness="1"
                      FontFamily="Segoe UI Semibold"
                      FontSize="12">
                    <MenuItem Header="_File" SubmenuOpened="FileMenu_SubmenuOpened">
                        <MenuItem Header="_New project" Click="NewProjectMenuItem_Click" InputGestureText="Ctrl+N" />
                        <MenuItem Header="_Open project..." Click="OpenProjectMenuItem_Click" InputGestureText="Ctrl+L" />
                        <MenuItem x:Name="OpenRecentMenuItem" Header="Open _recent" />
                        <Separator />
                        <MenuItem Header="_Save project" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S" />
                        <MenuItem Header="Save _As..." Command="{Binding SaveProjectAsCommand}" InputGestureText="Ctrl+Shift+S" />
                        <MenuItem x:Name="AutosaveMenuItem" Header="Auto_save"
                                  ToolTip="How often a copy of the project is kept while it has unsaved changes, to recover the work if Sonator stops without saving" />
                        <Separator />
                        <MenuItem Header="Import _MIDI..." Command="{Binding ImportMidiCommand}" />
                        <MenuItem Header="Import a_udio (WAV, MP3)..." Click="ImportAudioMenuItem_Click"
                                  ToolTip="Put an audio file into the selected track, or the first empty one, or a new audio track. A file can also be dropped on an empty track" />
                        <MenuItem Header="_Export audio (WAV)..." Click="ExportAudioMenuItem_Click" InputGestureText="Ctrl+E" />
                        <MenuItem Header="Export _MIDI..." Click="ExportMidiMenuItem_Click" />
                        <MenuItem Header="Close _project" Click="CloseProjectMenuItem_Click" />
