                        <MenuItem Header="Piano roll..." Click="PianoRollMenuItem_Click" />
                        <MenuItem Header="New MIDI channel track" Click="AddMidiTrackMenuItem_Click" />
                        <MenuItem Header="New VST track" Click="AddVstTrackMenuItem_Click" />
                        <MenuItem Header="New audio input track" Click="AddAudioTrackMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="Transpose +1" Command="{Binding TransposeUpCommand}" />
                        <MenuItem Header="Transpose -1" Command="{Binding TransposeDownCommand}" />
                    </MenuItem>
                    <MenuItem Header="_MIDI">
                        <MenuItem Header="Import MIDI..." Command="{Binding ImportMidiCommand}" />
                        <Separator />
                        <MenuItem Header="Input device" ItemsSource="{Binding MidiInputDevices}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding DisplayName}" />
                                    <Setter Property="IsCheckable" Value="True" />
                                    <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                                    <Setter Property="Command" Value="{Binding DataContext.SelectMidiInputCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="Play keyboard on selected track" IsCheckable="True" IsChecked="{Binding IsLiveKeyboardEnabled}" />
                        <MenuItem Header="Refresh devices" Command="{Binding RefreshMidiDevicesCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Audio">
                        <MenuItem Header="Refresh audio devices" Command="{Binding RefreshAudioOutputsCommand}" />
                        <Separator />
                        <MenuItem Header="Backend">
                            <MenuItem Header="WASAPI" IsCheckable="True"
                                      IsChecked="{Binding IsWasapiBackend, Mode=OneWay}"
                                      Command="{Binding SelectAudioBackendCommand}" CommandParameter="WASAPI" />
                            <MenuItem Header="ASIO" IsCheckable="True"
                                      IsChecked="{Binding IsAsioBackend, Mode=OneWay}"
                                      IsEnabled="{Binding IsAsioSupported}"
                                      Command="{Binding SelectAudioBackendCommand}" CommandParameter="ASIO" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="WASAPI output device" IsEnabled="{Binding IsWasapiBackend}" ItemsSource="{Binding AudioOutputDevices}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding DisplayName}" />
                                    <Setter Property="IsCheckable" Value="True" />
                                    <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                                    <Setter Property="Command" Value="{Binding DataContext.SelectAudioOutputCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="ASIO driver" IsEnabled="{Binding IsAsioBackend}" ItemsSource="{Binding AsioDrivers}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding DisplayName}" />
                                    <Setter Property="IsCheckable" Value="True" />
                                    <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                                    <Setter Property="Command" Value="{Binding DataContext.SelectAsioDriverCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Driver settings..." Click="DriverSettingsMenuItem_Click" />
                        <MenuItem Header="Measure latency" Click="MeasureLatencyMenuItem_Click" />
                        <MenuItem Header="Mixer..." Click="MixerMenuItem_Click" />
                        <MenuItem Header="Waveform editor..." Click="WaveformEditorMenuItem_Click" />
                    </MenuItem>
                </Menu>

                <TextBlock Text="{Binding SongTitle, StringFormat='{}{0} — SONATOR 1.0'}"
