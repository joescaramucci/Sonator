                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BARS" VerticalAlignment="Center" FontSize="11" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SelectedArrangePatternLength, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalContentAlignment="Center"
                                     Padding="1,0" />
                            <TextBlock Grid.Column="2" Text="TRANSPOSE" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="11" />
                            <TextBox Grid.Column="3"
                                     Text="{Binding SelectedPatternTranspose, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalContentAlignment="Center"
                                     Padding="1,0" />
                        </Grid>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="START" VerticalAlignment="Center" FontSize="10" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SelectedArrangePatternStart, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Padding="1,0"
                                     HorizontalContentAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="END" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10" />
                            <TextBox Grid.Column="3"
                                     Text="{Binding SelectedArrangePatternEnd, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Padding="1,0"
                                     HorizontalContentAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LENGTH" VerticalAlignment="Center" FontSize="10" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SelectedArrangePatternLengthDisplay, UpdateSourceTrigger=LostFocus}"
                                     Padding="1,0"
                                     HorizontalContentAlignment="Center" />
                        </Grid>
                        <UniformGrid Columns="4" Margin="0,3,0,0">
                            <Button Content="&#x2191; PREV" Command="{Binding MoveArrangePatternUpCommand}" />
                            <Button Content="&#x2193; NEXT" Command="{Binding MoveArrangePatternDownCommand}" />
                            <Button Content="COPY" Command="{Binding CopyArrangePatternCommand}" />
                            <Button Content="DELETE" Command="{Binding DeleteArrangePatternCommand}" />
                        </UniformGrid>
                        <Button Content="CREATE NEW PATTERN"
                                Command="{Binding CreateArrangePatternCommand}"
                                Margin="0,3,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Height="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.28*" />
                                    <ColumnDefinition Width="1.12*" />
                                    <ColumnDefinition Width="0.62*" />
                                    <ColumnDefinition Width="0.62*" />
                                    <ColumnDefinition Width="0.62*" />
                                    <ColumnDefinition Width="0.62*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="BAR" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontFamily="Consolas" Foreground="#D2D3D5" />
                                <TextBlock Grid.Column="1" Text="ARRANGE" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" Foreground="#D2D3D5" />
                                <TextBlock Grid.Column="2" Text="a" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" Foreground="#D2D3D5" />
                                <TextBlock Grid.Column="3" Text="b" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" Foreground="#D2D3D5" />
                                <TextBlock Grid.Column="4" Text="c" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" Foreground="#D2D3D5" />
                                <TextBlock Grid.Column="5" Text="d" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" Foreground="#D2D3D5" />
                            </Grid>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                            <ItemsControl x:Name="SongArrangeRowsItemsControl"
                                          ItemsSource="{Binding VisibleSongArrangeRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34"
                                              AllowDrop="True"
                                              Cursor="Hand"
                                              DragOver="ArrangePatternRow_DragOver"
                                              Drop="ArrangePatternRow_Drop"
                                              MouseEnter="ArrangePatternRow_MouseEnter"
                                              MouseLeave="ArrangePatternRow_MouseLeave">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.28*" />
                                                <ColumnDefinition Width="1.12*" />
                                                <ColumnDefinition Width="0.62*" />
                                                <ColumnDefinition Width="0.62*" />
                                                <ColumnDefinition Width="0.62*" />
                                                <ColumnDefinition Width="0.62*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    BorderBrush="{StaticResource Line}"
                                                    BorderThickness="1"
                                                    PreviewMouseDown="ArrangeBar_PreviewMouseDown">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                       <Setter Property="Background" Value="#414141" />
                                                        <Style.Triggers>
                                                           <DataTrigger Binding="{Binding IsPointerOver}" Value="True">
                                                               <Setter Property="Background" Value="#5D5D5D" />
                                                           </DataTrigger>
                                                           <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                               <Setter Property="Background" Value="#7A7B7D" />
                                                           </DataTrigger>
                                                           <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                               <Setter Property="Background" Value="#2D745D" />
                                                           </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding DisplayBarNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#D2D3D5" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPointerOver}" Value="True">
                                                                    <Setter Property="Foreground" Value="#D6D7D9" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="#D6D7D9" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <Border Grid.Column="1"
                                                    BorderBrush="{StaticResource Line}"
                                                    BorderThickness="1,1,0,1"
                                                    PreviewMouseDown="ArrangePatternRow_PreviewMouseDown"
                                                    PreviewMouseMove="ArrangePatternListItem_PreviewMouseMove"
                                                    PreviewMouseLeftButtonUp="ArrangePatternListItem_PreviewMouseLeftButtonUp">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                       <Setter Property="Background" Value="#414141" />
                                                       <Style.Triggers>
                                                           <DataTrigger Binding="{Binding IsPointerOver}" Value="True">
                                                               <Setter Property="Background" Value="#5D5D5D" />
                                                           </DataTrigger>
                                                           <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                               <Setter Property="Background" Value="#7A7B7D" />
                                                           </DataTrigger>
                                                           <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                               <Setter Property="Background" Value="#2D745D" />
                                                           </DataTrigger>
                                                           <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                               <Setter Property="Background" Value="#2F78C4" />
                                                           </DataTrigger>
                                                       </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding DisplayPatternName}" Margin="4,0" VerticalAlignment="Center" FontFamily="Consolas" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                       <Style TargetType="TextBlock">
                                                           <Setter Property="Foreground" Value="#D2D3D5" />
                                                           <Style.Triggers>
                                                               <DataTrigger Binding="{Binding IsPointerOver}" Value="True">
                                                                   <Setter Property="Foreground" Value="#D6D7D9" />
                                                               </DataTrigger>
                                                               <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                   <Setter Property="Foreground" Value="#D6D7D9" />
                                                               </DataTrigger>
                                                           </Style.Triggers>
                                                       </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <ItemsControl Grid.Column="2"
                                                         Grid.ColumnSpan="4"
                                                         ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                       <UniformGrid Columns="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                       <Border BorderBrush="{StaticResource Line}"
                                                               BorderThickness="1,1,0,1"
                                                               PreviewMouseDown="ArrangeCell_PreviewMouseDown">
                                                           <Border.Style>
                                                               <Style TargetType="Border">
                                                                   <Setter Property="Background" Value="#494949" />
                                                                   <Style.Triggers>
                                                                       <DataTrigger Binding="{Binding DataContext.IsPointerOver, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                           <Setter Property="Background" Value="#696969" />
                                                                       </DataTrigger>
                                                                       <DataTrigger Binding="{Binding DataContext.IsSelected, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                           <Setter Property="Background" Value="#7A7B7D" />
                                                                       </DataTrigger>
                                                                       <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                           <Setter Property="Background" Value="#7A7B7D" />
                                                                       </DataTrigger>
                                                                   </Style.Triggers>
                                                               </Style>
                                                           </Border.Style>
                                                           <TextBlock Text="{Binding DisplayLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11">
                                                               <TextBlock.Style>
                                                                   <Style TargetType="TextBlock">
                                                                       <Setter Property="Foreground" Value="#D2D3D5" />
                                                                       <Style.Triggers>
                                                                           <DataTrigger Binding="{Binding DataContext.IsPointerOver, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                               <Setter Property="Foreground" Value="#D6D7D9" />
                                                                           </DataTrigger>
                                                                           <DataTrigger Binding="{Binding DataContext.IsSelected, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                               <Setter Property="Foreground" Value="#D6D7D9" />
                                                                           </DataTrigger>
                                                                           <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                               <Setter Property="Foreground" Value="#D6D7D9" />
                                                                           </DataTrigger>
                                                                       </Style.Triggers>
                                                                   </Style>
                                                               </TextBlock.Style>
                                                           </TextBlock>
                                                       </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </Border>
                            <Border Height="26"
                                    Margin="0,4,1,0"
                                    AllowDrop="True"
                                    Background="#343434"
                                    BorderBrush="#77787A"
                                    BorderThickness="1"
                                    DragOver="ArrangePatternEndDrop_DragOver"
                                    Drop="ArrangePatternEndDrop_Drop">
                                <TextBlock Text="DROP HERE TO MOVE TO END"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="#B9BABC" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" local:HelpBadge.Topic="Arrange">
                <!-- The timeline's zoom and snap controls sit in the ARRANGE title row, leaving the bar ruler free. -->
                <GroupBox.Header>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="ARRANGE" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,-2,16,-2"> <!-- room on the right for the help's "?" -->
                            <TextBlock Text="ZOOM"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       Margin="0,0,4,0"
                                       Foreground="#CDCED0" />
                            <Slider Width="90"
                                    Height="18"
                                    Minimum="{x:Static vm:MainViewModel.MinTimelineBarWidth}"
                                    Maximum="{x:Static vm:MainViewModel.MaxTimelineBarWidth}"
                                    Value="{Binding TimelineBarWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="Bar width"
                                    AutomationProperties.Name="TIMELINE ZOOM" />
                            <Button Content="−" AutomationProperties.Name="TIMELINE ZOOM OUT" Command="{Binding ZoomTimelineOutCommand}" Width="20" Height="18" Padding="0" ToolTip="Reduce bar width" />
                            <Button Content="+" AutomationProperties.Name="TIMELINE ZOOM IN" Command="{Binding ZoomTimelineInCommand}" Width="20" Height="18" Padding="0" ToolTip="Increase bar width" />
                            <Button Content="FIT" AutomationProperties.Name="TIMELINE ZOOM TO FIT" Command="{Binding ZoomToFitCommand}" Width="34" Height="18" Padding="0" ToolTip="Zoom so every bar of the pattern is visible" />
                            <Button Content="{Binding RecordGridText}" AutomationProperties.Name="RECORD QUANTIZE" Command="{Binding CycleRecordGridCommand}" Width="78" Height="18" Padding="0" ToolTip="Grid recorded notes snap to. Off records the exact timing. Press to change." />
                            <Button Content="{Binding SnapText}" AutomationProperties.Name="TIMELINE SNAP" Command="{Binding CycleSnapCommand}" Width="74" Height="18" Padding="0" ToolTip="Snap the blocks to bars, quarter notes or sixteenths. Press to change." />
                        </StackPanel>
                    </DockPanel>
                </GroupBox.Header>
                <Grid>
                <ScrollViewer x:Name="ArrangeTimelineScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="Timeline_PreviewMouseWheel"
                              PreviewMouseDown="ArrangeTimelineScrollViewer_PreviewMouseDown"
                              PreviewMouseMove="ArrangeTimelineScrollViewer_PreviewMouseMove"
                              PreviewMouseUp="ArrangeTimelineScrollViewer_PreviewMouseUp"
                              SizeChanged="ArrangeTimelineScrollViewer_SizeChanged">
                <Grid Width="{Binding TimelineWorkspaceWidth}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="42" Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="5,2">
                            <TextBlock Text="{Binding SelectedPattern.Name}" FontWeight="Bold" FontFamily="Consolas" />
                            <TextBlock Text="{Binding SelectedPattern.Summary}" FontSize="10" FontFamily="Consolas" />
                        </StackPanel>
                        <ItemsControl Grid.Column="1"
                                      Width="{Binding TimelineContentWidth}"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding TimelineBarNumbers}"
                                      Tag="TimelineRuler"
                                      Background="Transparent"
                                      MouseRightButtonUp="TimelineRuler_MouseRightButtonUp"
                                      SnapsToDevicePixels="True"
                                      UseLayoutRounding="True"
                                      PreviewMouseWheel="Timeline_PreviewMouseWheel"
                                      PreviewMouseLeftButtonDown="TimelineRuler_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="TimelineRuler_PreviewMouseMove"
                                      PreviewMouseLeftButtonUp="TimelineRuler_PreviewMouseLeftButtonUp">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="{Binding DataContext.TimelineBarWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock HorizontalAlignment="Left"
                                                   Margin="3,0,0,0"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource RulerBarLabelConverter}">
                                                    <Binding />
                                                    <Binding Path="DataContext.TimelineBarWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Markers along the top of the ruler, changes of tempo along its bottom: a click goes there,
                             a right-click changes or removes one. -->
                        <ItemsControl Grid.Column="1"
                                      Width="{Binding TimelineContentWidth}"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding RulerFlags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTempo}" Value="True">
                                            <Setter Property="Canvas.Top" Value="27" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="14" Padding="4,0" CornerRadius="0,3,3,0" BorderThickness="2,0,0,0" Cursor="Hand"
                                            MouseLeftButtonUp="RulerFlag_MouseLeftButtonUp" MouseRightButtonUp="RulerFlag_MouseRightButtonUp">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E6C45B" />
                                                <Setter Property="BorderBrush" Value="#FFF2C2" />
                                                <Setter Property="ToolTip" Value="Marker: click to go there, right-click to rename or remove it" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTempo}" Value="True">
                                                        <Setter Property="Background" Value="#62B7A4" />
                                                        <Setter Property="BorderBrush" Value="#D6FFF4" />
                                                        <Setter Property="ToolTip" Value="Change of tempo: right-click to change or remove it" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="Bold" Foreground="#0F1A14" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <ListBox x:Name="TimelineBodyListBox"
                             ItemsSource="{Binding TimelineTracks}"
                             SelectedValuePath="SourceTrack"
                             SelectedValue="{Binding SelectedTrack, Mode=TwoWay}"
                             MouseDoubleClick="TrackList_MouseDoubleClick"
                             Width="{Binding TimelineWorkspaceWidth}"
                             Background="Transparent"
                             BorderThickness="0"
                             PreviewMouseLeftButtonDown="TimelineBodyListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseRightButtonDown="TimelineBodyListBox_PreviewMouseRightButtonDown"
                             PreviewMouseRightButtonUp="TimelineBodyListBox_PreviewMouseRightButtonUp"
                             PreviewMouseMove="TimelineBodyListBox_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="TimelineBodyListBox_PreviewMouseLeftButtonUp"
                             AllowDrop="True"
                             DragOver="TimelineBodyListBox_DragOver"
                             Drop="TimelineBodyListBox_Drop"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.ScrollChanged="TimelineTrackList_ScrollChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <!-- The selected track gets a thin light outline. The row keeps its size, so headers and lanes stay aligned. -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid Background="Transparent" Margin="1" SnapsToDevicePixels="True">
                                                <ContentPresenter />
                                                <Border x:Name="SelectionOutline"
                                                        Margin="-0.5"
                                                        BorderBrush="#DADADA"
                                                        BorderThickness="0.5"
                                                        IsHitTestVisible="False"
                                                        Visibility="Collapsed" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="SelectionOutline" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="64">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0.5" Background="{Binding SourceTrack.TrackColorBrush}" Padding="3">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Default" Tag="" Click="TrackColorMenuItem_Click">
                                                    <MenuItem.Icon>
                                                        <Border Width="12" Height="12" Background="#3D3D3D" BorderBrush="#6F87A0" BorderThickness="1" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Red" Tag="#FFD94C4C" Click="TrackColorMenuItem_Click">
                                                    <MenuItem.Icon>
                                                        <Border Width="12" Height="12" Background="#FFD94C4C" BorderBrush="#A62B2B" BorderThickness="1" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Orange" Tag="#FFDE8A3B" Click="TrackColorMenuItem_Click">
                                                    <MenuItem.Icon>
                                                        <Border Width="12" Height="12" Background="#FFDE8A3B" BorderBrush="#A86425" BorderThickness="1" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Yellow" Tag="#FFE6C45B" Click="TrackColorMenuItem_Click">
                                                    <MenuItem.Icon>
                                                        <Border Width="12" Height="12" Background="#FFE6C45B" BorderBrush="#AE8F2F" BorderThickness="1" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Green" Tag="#FF5FB87B" Click="TrackColorMenuItem_Click">
                                                    <MenuItem.Icon>
                                                        <Border Width="12" Height="12" Background="#FF5FB87B" BorderBrush="#3F7D53" BorderThickness="1" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Cyan" Tag="#FF5CAFD6" Click="TrackColorMenuItem_Click">
                                                    <MenuItem.Icon>
                                                        <Border Width="12" Height="12" Background="#FF5CAFD6" BorderBrush="#3D7A94" BorderThickness="1" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Blue" Tag="#FF5F8FDE" Click="TrackColorMenuItem_Click">
                                                    <MenuItem.Icon>
                                                        <Border Width="12" Height="12" Background="#FF5F8FDE" BorderBrush="#3C6195" BorderThickness="1" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Purple" Tag="#FF9C72D8" Click="TrackColorMenuItem_Click">
                                                    <MenuItem.Icon>
                                                        <Border Width="12" Height="12" Background="#FF9C72D8" BorderBrush="#6F4F9D" BorderThickness="1" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Gray" Tag="#FF8E8F91" Click="TrackColorMenuItem_Click">
                                                    <MenuItem.Icon>
                                                        <Border Width="12" Height="12" Background="#FF8E8F91" BorderBrush="#696969" BorderThickness="1" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="14" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="34" />
                                                <RowDefinition Height="20" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Content="M"
                                                        Width="22" Height="18" Padding="0"
                                                        Command="{Binding DataContext.ToggleTrackMuteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding SourceTrack}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Background" Value="#5C5C5C" />
                                                            <Setter Property="BorderBrush" Value="#6F87A0" />
                                                            <Setter Property="Foreground" Value="#CDCED0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SourceTrack.IsMuted}" Value="True">
                                                                    <Setter Property="Background" Value="#49B88D" />
                                                                    <Setter Property="Foreground" Value="#0F1A14" />
                                                                    <Setter Property="BorderBrush" Value="#2F8F6A" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="S"
                                                        Width="22" Height="18" Padding="0"
                                                        Command="{Binding DataContext.ToggleTrackSoloCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding SourceTrack}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Background" Value="#555555" />
                                                            <Setter Property="BorderBrush" Value="#7C7D7F" />
                                                            <Setter Property="Foreground" Value="#CDCED0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SourceTrack.IsSolo}" Value="True">
                                                                    <Setter Property="Background" Value="#49B88D" />
                                                                    <Setter Property="Foreground" Value="#0F1A14" />
                                                                    <Setter Property="BorderBrush" Value="#2F8F6A" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding SourceTrack.Name}"
                                                           FontWeight="Bold"
                                                           Foreground="#EEEFF1"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="10" Foreground="#ACADAF">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SourceTrack.HasPlugin}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding SourceTrack.Instrument, Mode=OneWay}" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{Binding SourceTrack.DisplayTrackType, Mode=OneWay}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding SourceTrack.RoutingDisplay, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding SourceTrack.PluginAndSoundName}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#9FD3F2"
                                                           TextTrimming="CharacterEllipsis"
                                                           Cursor="Hand"
                                                           Tag="PluginName"
                                                           ToolTip="Double-click to open the plug-in window"
                                                           MouseLeftButtonDown="TrackPluginName_MouseLeftButtonDown">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SourceTrack.HasPlugin}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Grid Grid.Row="1" Grid.ColumnSpan="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton Content="R"
                                                              Width="22"
                                                              Height="18"
                                                              Padding="0"
                                                              Focusable="False"
                                                              Style="{StaticResource TrackRecordArmButton}"
                                                              AutomationProperties.Name="RECORD ARM"
                                                              IsChecked="{Binding SourceTrack.IsRecordArmed, Mode=OneWay}" Command="{Binding DataContext.ToggleTrackRecordArmCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding SourceTrack}"
                                                              ToolTip="Arm this track. Keys played on the MIDI keyboard are recorded into the armed track while recording is on" />
                                                <local:VolumeBar Grid.Column="1"
                                                                 Height="16"
                                                                 BarThickness="5"
                                                                 Margin="3,0,1,0"
                                                                 IsPan="True"
                                                                 DefaultValue="0"
                                                                 Tag="VolumeBar"
                                                                 AutomationProperties.Name="TRACK PAN"
                                                                 Value="{Binding SourceTrack.MixPan}"
                                                                 ToolTip="Pan: drag left or right, double-click to centre" />
                                            </Grid>
                                           <Slider Grid.RowSpan="2"
                                                   Grid.Column="2"
                                                   Width="16"
                                                   Height="44"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Minimum="0"
                                                   Maximum="100"
                                                   Orientation="Vertical"
                                                   IsDirectionReversed="False"
                                                   AutoToolTipPlacement="TopLeft"
                                                   AutoToolTipPrecision="0"
                                                   Focusable="False"
                                                   AutomationProperties.Name="TRACK VOLUME"
                                                   Value="{Binding SourceTrack.MixVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource VolumePercentConverter}}"
                                                   ToolTip="Track volume" />
                                           <ProgressBar Grid.RowSpan="2"
                                                        Grid.Column="3"
                                                        Style="{StaticResource VerticalMeter}"
                                                        Value="{Binding SourceTrack.SignalLevel}"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Channel level" />
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Column="1"
                                          Width="{Binding DataContext.TimelineContentWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Background="Transparent"
                                          ClipToBounds="True">
                                        <Rectangle Fill="{Binding SourceTrack.TrackColorBrush}" Opacity="0.35" IsHitTestVisible="False" />
                                        <!-- The lane's grid and its active steps, drawn at once: a long song has thousands of steps a lane. -->
                                        <local:TimelineLane Steps="{Binding Steps}"
                                                            StepBrush="{Binding SourceTrack.TrackColorBrush}"
                                                            StepWidth="{Binding DataContext.TimelineSixteenthWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            StepsPerBar="{Binding DataContext.StepsPerBar, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            StepsPerBeat="{Binding DataContext.Meter.StepsPerBeat, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            ShowSteps="{Binding HasStepCells}"
                                                            IsHitTestVisible="False" />
                                        <!-- The audio clip, where it starts: drag it along to move it in time (SNAP sets the grid),
                                             or onto another empty track to move it there; double-click it to edit it. -->
                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Stretch"
                                                CornerRadius="2"
                                                Background="#24463F"
                                                BorderBrush="#62B7A4"
                                                BorderThickness="1"
                                                Tag="AudioClip"
                                                ToolTip="Audio clip: drag it along to move it in time, or onto another empty track. Double-click to edit it"
                                                PreviewMouseLeftButtonDown="AudioClip_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="AudioClip_PreviewMouseMove"
                                                PreviewMouseLeftButtonUp="AudioClip_PreviewMouseLeftButtonUp">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Detect tempo and sync the song..." Click="DetectTempoMenuItem_Click" />
                                                    <MenuItem Header="Edit in the waveform editor" Click="EditClipMenuItem_Click" />
                                                    <MenuItem Header="Correct the pitch in Sondyne..." Click="SondyneMenuItem_Click" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Border.Margin>
                                                <MultiBinding Converter="{StaticResource StepOffsetConverter}">
                                                    <Binding Path="AudioStartStep" />
                                                    <Binding Path="DataContext.TimelineSixteenthWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                </MultiBinding>
                                            </Border.Margin>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAudioClip}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource AudioClipWidthConverter}">
                                                    <Binding Path="AudioLengthSteps" />
                                                    <Binding Path="DataContext.TimelineSixteenthWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                </MultiBinding>
                                            </Border.Width>
                                            <Viewbox Stretch="Fill" Margin="2">
                                                <Canvas Width="1000" Height="100">
                                                    <Path Fill="#62B7A4" Data="{Binding AudioPathData}" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <!-- The track's blocks of notes, opaque over the lane's grid. Each keeps its bounds, so blocks
                                             side by side show as two until joined. Drag one to move it, drag an edge to stretch it;
                                             a rectangle drawn on the lane selects the blocks it touches, and the right button's menu
                                             joins them. -->
                                        <ItemsControl ItemsSource="{Binding Blocks}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="3"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Stretch"
                                                            Tag="NoteBlock"
                                                            PreviewMouseLeftButtonDown="NoteBlock_PreviewMouseLeftButtonDown"
                                                            PreviewMouseMove="NoteBlock_PreviewMouseMove"
                                                            PreviewMouseLeftButtonUp="NoteBlock_PreviewMouseLeftButtonUp"
                                                            ContextMenuOpening="NoteBlock_ContextMenuOpening">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Join" Tag="Join" InputGestureText="Ctrl+J" Click="JoinBlocksMenuItem_Click" />
                                                                <Separator />
                                                                <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="CopyBlocksMenuItem_Click" />
                                                                <MenuItem Header="Paste after the last block" InputGestureText="Ctrl+V" Click="PasteBlocksMenuItem_Click" />
                                                                <MenuItem Header="Delete" InputGestureText="Del" Click="DeleteBlocksMenuItem_Click" />
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Border.Margin>
                                                            <MultiBinding Converter="{StaticResource StepOffsetConverter}">
                                                                <Binding Path="StartStep" />
                                                                <Binding Path="DataContext.TimelineSixteenthWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </Border.Margin>
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource AudioClipWidthConverter}">
                                                                <Binding Path="LengthSteps" />
                                                                <Binding Path="DataContext.TimelineSixteenthWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <!-- Opaque, so the block reads as one colour over the lane's grid. -->
                                                                <Setter Property="Background" Value="{StaticResource Paper}" />
                                                                <Setter Property="BorderBrush" Value="#F7F8FA" />
                                                                <Setter Property="BorderThickness" Value="0.5" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRepeat}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.55" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#FFD24C" />
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Border CornerRadius="2" Background="{Binding TrackColorBrush}" />
                                                            <Border CornerRadius="2" Background="{StaticResource Bevel.Sheen}" IsHitTestVisible="False" />
                                                            <Border HorizontalAlignment="Left"
                                                                    Width="10"
                                                                    Background="Transparent"
                                                                    BorderBrush="#F7F8FA"
                                                                    BorderThickness="1.5,0,0,0"
                                                                    Cursor="SizeWE"
                                                                    Tag="NoteBlockStartEdge" />
                                                            <Border HorizontalAlignment="Right"
                                                                    Width="10"
                                                                    Background="Transparent"
                                                                    BorderBrush="#F7F8FA"
                                                                    BorderThickness="0,0,1.5,0"
                                                                    Cursor="SizeWE"
                                                                    Tag="NoteBlockEdge" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- The track's volume or pan automation, over the row while it is shown (Track menu). -->
                                        <local:AutomationLane Tag="AutomationLane"
                                                              Points="{Binding SourceTrack.ShownAutomationPoints}"
                                                              Minimum="{Binding SourceTrack.ShownAutomationMinimum}"
                                                              IdleValue="{Binding SourceTrack.ShownAutomationIdleValue, Mode=OneWay}"
                                                              StepWidth="{Binding DataContext.TimelineSixteenthWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              EditStarting="AutomationLane_EditStarting">
                                            <local:AutomationLane.Style>
                                                <Style TargetType="local:AutomationLane">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SourceTrack.ShownAutomation}" Value="{x:Static vm:AutomationTarget.None}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </local:AutomationLane.Style>
                                        </local:AutomationLane>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <!-- The bar lines on the ruler; on the lanes, each lane draws them under its blocks. -->
                <ItemsControl Margin="260,0,0,0"
                              Width="{Binding TimelineContentWidth}"
                              Height="45"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding TimelineBarNumbers}"
                              IsHitTestVisible="False"
                              Panel.ZIndex="8"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="{Binding DataContext.TimelineBarWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Border Width="0.5"
                                        HorizontalAlignment="Left"
                                        Background="#4F8F83" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Where the song plays, one dashed line down all the lanes, below the ruler. -->
                <Border Margin="260,45,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Panel.ZIndex="9">
                    <Line X1="0" X2="0" Y1="0" Y2="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"
                          Stroke="#E4E5E7" StrokeThickness="1" StrokeDashArray="1 2" SnapsToDevicePixels="True">
                        <Line.Margin>
                            <MultiBinding Converter="{StaticResource StepOffsetConverter}" ConverterParameter="0">
                                <Binding Path="TimelinePlayheadStep" />
                                <Binding Path="TimelineSixteenthWidth" />
                            </MultiBinding>
                        </Line.Margin>
                    </Line>
                </Border>
                <!-- The part of the song chosen to loop, over the ruler and the lanes, its L and R locators on the ruler. -->
                <Grid IsHitTestVisible="False" Visibility="{Binding HasLoopRange, Converter={StaticResource VisibleWhenLoopRange}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" HorizontalAlignment="Left" Background="#24FFD24C" BorderBrush="#FFD24C" BorderThickness="1.5,0,1.5,0">
                        <Border.Margin>
                            <MultiBinding Converter="{StaticResource StepOffsetConverter}">
                                <Binding Path="LoopStartStep" />
                                <Binding Path="TimelineSixteenthWidth" />
                            </MultiBinding>
                        </Border.Margin>
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource AudioClipWidthConverter}">
                                <Binding Path="LoopRangeSteps" />
                                <Binding Path="TimelineSixteenthWidth" />
                            </MultiBinding>
                        </Border.Width>
                        <Grid VerticalAlignment="Top" Height="14" Margin="0,8,0,0">
                            <Border HorizontalAlignment="Left" Background="#FFD24C" CornerRadius="0,3,3,0" Padding="3,0">
                                <TextBlock Text="L" FontSize="10" FontWeight="Bold" Foreground="#2A2006" VerticalAlignment="Center" />
                            </Border>
                            <Border HorizontalAlignment="Right" Background="#FFD24C" CornerRadius="3,0,0,3" Padding="3,0">
                                <TextBlock Text="R" FontSize="10" FontWeight="Bold" Foreground="#2A2006" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
                </Grid>
                </ScrollViewer>
                <!-- Starts where the lanes start: below the 42-high ruler and its 3-pixel margin. -->
                <Border Width="260"
                        Margin="0,45,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{StaticResource Paper}"
                        Panel.ZIndex="10">
                    <DockPanel>
                    <UniformGrid DockPanel.Dock="Bottom"
                                 Columns="2"
                                 Height="24"
                                 Margin="0,3,0,0">
                        <Button Content="NEW TRACK"
                                Command="{Binding AddTrackCommand}"
                                CommandParameter="midi"
                                Padding="2,0"
                                FontSize="10" />
                        <Button Content="DELETE TRACK"
                                Command="{Binding DeleteTrackCommand}"
                                Padding="2,0"
                                FontSize="10" />
                    </UniformGrid>
                    <ListBox x:Name="FrozenTrackListBox"
                             ItemsSource="{Binding TimelineTracks}"
                             SelectedValuePath="SourceTrack"
                             SelectedValue="{Binding SelectedTrack, Mode=TwoWay}"
                             MouseDoubleClick="TrackList_MouseDoubleClick"
                             Background="{StaticResource Paper}"
                             BorderThickness="0"
                             AllowDrop="True"
                             DragOver="TimelineBodyListBox_DragOver"
                             Drop="TimelineBodyListBox_Drop"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.ScrollChanged="TimelineTrackList_ScrollChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <!-- The selected track gets a thin light outline. The row keeps its size, so headers and lanes stay aligned. -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid Background="Transparent" Margin="1" SnapsToDevicePixels="True">
                                                <ContentPresenter />
                                                <Border x:Name="SelectionOutline"
                                                        Margin="-0.5"
                                                        BorderBrush="#DADADA"
                                                        BorderThickness="0.5"
                                                        IsHitTestVisible="False"
                                                        Visibility="Collapsed" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="SelectionOutline" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Height="64"
                                        BorderBrush="{StaticResource Bevel.Outline}"
                                        BorderThickness="0.5"
                                        Background="{Binding SourceTrack.TrackColorBrush}"
                                        Padding="3">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Show volume automation" Click="ShowVolumeAutomation_Click" />
                                            <MenuItem Header="Show pan automation" Click="ShowPanAutomation_Click" />
                                            <MenuItem Header="Hide automation" Click="HideAutomation_Click" />
                                            <MenuItem Header="Clear the automation shown" Click="ClearAutomation_Click" />
                                            <Separator />
                                            <MenuItem Header="Default" Tag="" Click="TrackColorMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <Border Width="12" Height="12" Background="#3D3D3D" BorderBrush="#6F87A0" BorderThickness="1" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Red" Tag="#FFD94C4C" Click="TrackColorMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <Border Width="12" Height="12" Background="#FFD94C4C" BorderBrush="#A62B2B" BorderThickness="1" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Orange" Tag="#FFDE8A3B" Click="TrackColorMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <Border Width="12" Height="12" Background="#FFDE8A3B" BorderBrush="#A86425" BorderThickness="1" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Yellow" Tag="#FFE6C45B" Click="TrackColorMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <Border Width="12" Height="12" Background="#FFE6C45B" BorderBrush="#AE8F2F" BorderThickness="1" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Green" Tag="#FF5FB87B" Click="TrackColorMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <Border Width="12" Height="12" Background="#FF5FB87B" BorderBrush="#3F7D53" BorderThickness="1" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Cyan" Tag="#FF5CAFD6" Click="TrackColorMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <Border Width="12" Height="12" Background="#FF5CAFD6" BorderBrush="#3D7A94" BorderThickness="1" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Blue" Tag="#FF5F8FDE" Click="TrackColorMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <Border Width="12" Height="12" Background="#FF5F8FDE" BorderBrush="#3C6195" BorderThickness="1" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Purple" Tag="#FF9C72D8" Click="TrackColorMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <Border Width="12" Height="12" Background="#FF9C72D8" BorderBrush="#6F4F9D" BorderThickness="1" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Gray" Tag="#FF8E8F91" Click="TrackColorMenuItem_Click">
                                                <MenuItem.Icon>
                                                    <Border Width="12" Height="12" Background="#FF8E8F91" BorderBrush="#696969" BorderThickness="1" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="31" />
                                            <RowDefinition Height="23" />
                                        </Grid.RowDefinitions>
                                        <!-- Lit from above, as a raised strip. -->
                                        <Rectangle Grid.RowSpan="2" Grid.ColumnSpan="3" Margin="-3" Fill="{StaticResource Bevel.Sheen}" IsHitTestVisible="False" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="M"
                                                    Width="22"
                                                    Height="18"
                                                    Padding="0"
                                                    Command="{Binding DataContext.ToggleTrackMuteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding SourceTrack}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="#5C5C5C" />
                                                        <Setter Property="BorderBrush" Value="#6F87A0" />
                                                        <Setter Property="Foreground" Value="#CDCED0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SourceTrack.IsMuted}" Value="True">
                                                                <Setter Property="Background" Value="#49B88D" />
                                                                <Setter Property="Foreground" Value="#0F1A14" />
                                                                <Setter Property="BorderBrush" Value="#2F8F6A" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="S"
                                                    Width="22"
                                                    Height="18"
                                                    Padding="0"
                                                    Command="{Binding DataContext.ToggleTrackSoloCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding SourceTrack}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="#555555" />
                                                        <Setter Property="BorderBrush" Value="#7C7D7F" />
                                                        <Setter Property="Foreground" Value="#CDCED0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SourceTrack.IsSolo}" Value="True">
                                                                <Setter Property="Background" Value="#49B88D" />
                                                                <Setter Property="Foreground" Value="#0F1A14" />
                                                                <Setter Property="BorderBrush" Value="#2F8F6A" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding SourceTrack.Name}"
                                                       FontWeight="Bold"
                                                       Foreground="#EEEFF1"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Left"
                                                       Cursor="Hand"
                                                       Tag="TrackName"
                                                       ToolTip="Click to set the track's name and MIDI channel"
                                                       MouseLeftButtonDown="TrackName_MouseLeftButtonDown" />
                                            <TextBlock FontSize="10" Foreground="#ACADAF">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SourceTrack.HasPlugin}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding SourceTrack.Instrument, Mode=OneWay}" />
                                                <Run Text="  ·  " />
                                                <Run Text="{Binding SourceTrack.DisplayTrackType, Mode=OneWay}" />
                                                <Run Text="  " />
                                                <Run Text="{Binding SourceTrack.RoutingDisplay, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding SourceTrack.PluginAndSoundName}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#9FD3F2"
                                                       TextTrimming="CharacterEllipsis"
                                                       Cursor="Hand"
                                                       Tag="PluginName"
                                                       ToolTip="Double-click to open the plug-in window"
                                                       MouseLeftButtonDown="TrackPluginName_MouseLeftButtonDown">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SourceTrack.HasPlugin}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Grid Grid.Row="1" Grid.ColumnSpan="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Content="R"
                                                          Width="22"
                                                          Height="18"
                                                          Padding="0"
                                                          Focusable="False"
                                                          Style="{StaticResource TrackRecordArmButton}"
                                                          AutomationProperties.Name="RECORD ARM"
                                                          IsChecked="{Binding SourceTrack.IsRecordArmed, Mode=OneWay}" Command="{Binding DataContext.ToggleTrackRecordArmCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding SourceTrack}"
                                                          ToolTip="Arm this track. Keys played on the MIDI keyboard are recorded into the armed track while recording is on" />
                                            <!-- FX opens the track's effect rack, and lights green while one of its effects is on, as M and S do when on; only R lights red. -->
                                            <Button Grid.Column="1"
                                                    Content="FX"
                                                    Width="22"
                                                    Height="18"
                                                    Padding="0"
                                                    Focusable="False"
                                                    AutomationProperties.Name="FX RACK"
                                                    ToolTip="Open the track's effect rack. Green while one of its effects is on"
                                                    Click="TrackFxButton_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="#5C5C5C" />
                                                        <Setter Property="BorderBrush" Value="#6F87A0" />
                                                        <Setter Property="Foreground" Value="#9FD3F2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SourceTrack.Effects.Count}" Value="0">
                                                                <Setter Property="Foreground" Value="#CDCED0" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SourceTrack.HasActiveEffects}" Value="True">
                                                                <Setter Property="Background" Value="#49B88D" />
                                                                <Setter Property="Foreground" Value="#0F1A14" />
                                                                <Setter Property="BorderBrush" Value="#2F8F6A" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                        <!-- The track's instrument icon, under its name. Clicking it opens the icon picker. -->
                                        <Button Grid.Row="1"
                                                Grid.Column="1"
                                                Width="31"
                                                Height="23"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Focusable="False"
                                                Cursor="Hand"
                                                Tag="InstrumentIcon"
                                                Foreground="#F4F5F7"
                                                AutomationProperties.Name="INSTRUMENT ICON"
                                                ToolTip="Click to choose the instrument icon"
                                                Click="TrackInstrumentIcon_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="IconBorder" Background="Transparent" CornerRadius="4" Padding="3,1">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="IconBorder" Property="Background" Value="#33FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <ContentControl Content="{Binding SourceTrack.InstrumentIcon}" />
                                                <!-- Without an icon: a faint dashed box with a plus. -->
                                                <Grid Opacity="0.5">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SourceTrack.InstrumentIcon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Rectangle Stroke="#F4F5F7" StrokeThickness="1" StrokeDashArray="2 2" RadiusX="3" RadiusY="3" />
                                                    <TextBlock Text="+" FontSize="12" FontWeight="Bold" Foreground="#F4F5F7"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                                                </Grid>
                                            </Grid>
                                        </Button>
                                        <!-- The track volume: a bar after the icon, dragged left and right, marked VOL; then the pan, marked L and R with
                                             its centre. Their tooltips say exactly where they stand. -->
                                        <Grid Grid.Row="1" Grid.Column="1" Margin="38,1,52,0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="11" />
                                                <RowDefinition Height="8" />
                                            </Grid.RowDefinitions>
                                            <local:VolumeBar BarThickness="5" Tag="VolumeBar" AutomationProperties.Name="TRACK VOLUME" Value="{Binding SourceTrack.MixVolume}"
                                                             ToolTipService.InitialShowDelay="150">
                                                <local:VolumeBar.ToolTip>
                                                    <TextBlock><Run Text="Vol " /><Run Text="{Binding SourceTrack.VolumeDisplay, Mode=OneWay}" /><Run Text="   (double-click: 0 dB)" /></TextBlock>
                                                </local:VolumeBar.ToolTip>
                                            </local:VolumeBar>
                                            <TextBlock Grid.Row="1" Text="VOL" FontFamily="Arial" FontWeight="Bold" FontSize="6.5" Foreground="#B8BABC" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                        </Grid>
                                        <Grid Grid.Row="1" Grid.Column="1" Width="40" Margin="0,1,7,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="11" />
                                                <RowDefinition Height="8" />
                                            </Grid.RowDefinitions>
                                            <local:VolumeBar BarThickness="5" IsPan="True" DefaultValue="0" Tag="VolumeBar" AutomationProperties.Name="TRACK PAN"
                                                             Value="{Binding SourceTrack.MixPan}" ToolTipService.InitialShowDelay="150">
                                                <local:VolumeBar.ToolTip>
                                                    <TextBlock><Run Text="Pan " /><Run Text="{Binding SourceTrack.PanDisplay, Mode=OneWay}" /><Run Text="   (double-click: centre)" /></TextBlock>
                                                </local:VolumeBar.ToolTip>
                                            </local:VolumeBar>
                                            <TextBlock Grid.Row="1" Text="L" FontFamily="Arial" FontWeight="Bold" FontSize="6.5" Foreground="#B8BABC" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                            <Rectangle Grid.Row="1" Width="1" Height="4" Fill="#B8BABC" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False" />
                                            <TextBlock Grid.Row="1" Text="R" FontFamily="Arial" FontWeight="Bold" FontSize="6.5" Foreground="#B8BABC" HorizontalAlignment="Right" IsHitTestVisible="False" />
                                        </Grid>
                                        <!-- The track level as LEDs: green, red at the top, with the peak held for a moment. -->
                                        <local:LedMeter Grid.RowSpan="2"
                                                        Grid.Column="2"
                                                        Width="8"
                                                        Margin="0,4,2,4"
                                                        HorizontalAlignment="Right"
                                                        RedSegments="3"
                                                        Level="{Binding SourceTrack.SignalLevel}"
                                                        ToolTip="Track level: the measured sound for plug-in and audio tracks, from -42 to 0 dB; red above about -9 dB" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </DockPanel>
                </Border>
                <Border x:Name="ArrangePatternDragHandle"
                        Width="260"
                        Height="42"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{StaticResource Paper}"
                        Cursor="Hand"
                        ToolTip="Drag the pattern into the left list to move it"
                        AutomationProperties.Name="DRAG PATTERN"
                        PreviewMouseLeftButtonDown="ArrangePatternDragHandle_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="ArrangePatternDragHandle_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="ArrangePatternDragHandle_PreviewMouseLeftButtonUp"
                        Panel.ZIndex="11">
                    <StackPanel Margin="5,2">
                        <TextBlock Text="{Binding SelectedPattern.Name}" FontWeight="Bold" FontFamily="Consolas" Foreground="#EEEFF1" />
                        <TextBlock Text="{Binding SelectedPattern.Summary}" FontSize="10" FontFamily="Consolas" Foreground="#ACADAF" />
                    </StackPanel>
                </Border>
                </Grid>
            </GroupBox>

            <GroupBox Header="{Binding SelectedTrackHeader}" Grid.Column="2" local:HelpBadge.Topic="Track">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedTrack.Name}" FontSize="16" FontWeight="Bold" />
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedTrack.Instrument}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedTrack.DisplayTrackType}" HorizontalAlignment="Right" />
                    </Grid>

                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="4" Margin="0,4,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TRACK" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedTrackIndex}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="4" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ROUTING" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedTrack.RoutingDisplay}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="4" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BASE NOTE" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedTrack.NoteNumber}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <TextBlock Text="PLUGIN" FontSize="11" Margin="0,6,0,2" />
                    <ComboBox ItemsSource="{Binding VstPlugins}" DisplayMemberPath="Name" SelectedValuePath="FilePath"
                              SelectedValue="{Binding SelectedTrack.PluginFilePath}" Margin="0,0,0,4" ToolTip="The VST3 plug-in this track plays through" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                        <Button Content="EDIT" Width="50" Click="EditSelectedTrackButton_Click" />
                        <Button Content="PIANO ROLL" Margin="6,0,0,0" Click="PianoRollMenuItem_Click" />
                        <Button Content="PLUGIN WINDOW" Margin="6,0,0,0" Click="PluginWindowButton_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <Button Content="SOLO" Width="50" Command="{Binding ToggleTrackSoloCommand}" CommandParameter="{Binding SelectedTrack}" />
                        <Button Content="HIDE" Width="50" IsEnabled="False" ToolTip="Hiding tracks is not implemented yet" />
                    </StackPanel>
                    <Button Content="DEFAULT" Command="{Binding ResetTrackCommand}" />

                    <!-- The selected track's insert effects, top to bottom in the order the sound goes through them. -->
                    <DockPanel Margin="0,10,0,3">
                        <Button DockPanel.Dock="Right"
                                Content="+ ADD"
                                Width="64"
                                Height="22"
                                Padding="0"
                                FontSize="11"
                                AutomationProperties.Name="ADD EFFECT"
                                ToolTip="Add an effect to the track"
                                Click="AddEffectButton_Click" />
                        <TextBlock Text="EFFECTS" FontSize="11" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="No effects. Press + ADD." FontSize="11" Foreground="#98999B" Margin="2,2,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTrack.Effects.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding SelectedTrack.Effects}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" Padding="4,3" CornerRadius="5" Background="#353535" BorderBrush="#555555" BorderThickness="1">
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Left"
                                                      Content="ON"
                                                      Width="34"
                                                      Height="20"
                                                      Style="{StaticResource MetronomeToggleStyle}"
                                                      IsChecked="{Binding IsEnabled}"
                                                      AutomationProperties.Name="EFFECT ON"
                                                      ToolTip="Switch the effect on or off" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="▲" Width="22" Height="20" Padding="0" Margin="2,0,0,0" FontSize="9" Tag="-1" Click="MoveEffectButton_Click" ToolTip="Move earlier in the chain" />
                                            <Button Content="▼" Width="22" Height="20" Padding="0" Margin="2,0,0,0" FontSize="9" Tag="1" Click="MoveEffectButton_Click" ToolTip="Move later in the chain" />
                                            <Button Content="✕" Width="22" Height="20" Padding="0" Margin="2,0,0,0" Click="RemoveEffectButton_Click" ToolTip="Remove the effect" AutomationProperties.Name="REMOVE EFFECT" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="8,0,4,0"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Foreground="#EEEFF1"
                                                   Cursor="Hand"
                                                   ToolTip="Click to open the effect's knobs"
                                                   MouseLeftButtonUp="EffectName_MouseLeftButtonUp" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="{StaticResource Line}"
                            BorderThickness="1"
                            Background="#383838"
                            CornerRadius="4"
                            Padding="4"
                            Margin="0,6,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Background="#424242"
                                    BorderBrush="{StaticResource Line}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="3,3,0,0"
                                    Padding="2,1"
                                    Margin="0,0,0,4">
                                <DockPanel>
                                    <!-- The master's FX rack, on the whole mix: green while one of its effects is on. -->
                                    <Button DockPanel.Dock="Right"
                                            Content="FX"
                                            Width="22"
                                            Height="16"
                                            Padding="0"
                                            FontSize="9"
                                            Focusable="False"
                                            DataContext="{Binding MasterTrack}"
                                            AutomationProperties.Name="MASTER FX RACK"
                                            ToolTip="Open the master's effect rack: its effects run on the whole mix"
                                            Click="MasterFxButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="#5C5C5C" />
                                                <Setter Property="BorderBrush" Value="#6F87A0" />
                                                <Setter Property="Foreground" Value="#CDCED0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasActiveEffects}" Value="True">
                                                        <Setter Property="Background" Value="#49B88D" />
                                                        <Setter Property="Foreground" Value="#0F1A14" />
                                                        <Setter Property="BorderBrush" Value="#2F8F6A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Text="MASTER"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Ink}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar Style="{StaticResource MasterLevelMeterStyle}"
                                             Value="{Binding MasterSignalLevel, Mode=OneWay}"
                                             VerticalAlignment="Stretch"
                                             ToolTip="Master level" />
                                <Slider Grid.Column="1"
                                        Style="{StaticResource MasterMixSliderStyle}"
                                        Minimum="0"
                                        Maximum="100"
                                        Orientation="Vertical"
                                        IsDirectionReversed="False"
                                        AutoToolTipPlacement="TopLeft"
                                        AutoToolTipPrecision="0"
                                        Value="{Binding MasterVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource VolumePercentConverter}}"
                                        ToolTip="Final mix volume" />
                            </Grid>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding MasterVolume, Converter={StaticResource VolumePercentConverter}, StringFormat={}{0:0}%}"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Ink}"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </GroupBox>

            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Header="TRANSPORT" Grid.Row="0" local:HelpBadge.Topic="Transport">
                <StackPanel Margin="1">
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="4" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LEFT LOCATOR" FontSize="11" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding LoopStartStep, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalContentAlignment="Center"
                                     Padding="1,0" />
                        </Grid>
                    </Border>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="4" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RIGHT LOCATOR" FontSize="11" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding LoopEndStep, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalContentAlignment="Center"
                                     Padding="1,0" />
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="3" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TransportPosition}" VerticalAlignment="Center" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="REC" Margin="5,0,0,0" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="2" Margin="0,0,0,4">
                        <Button Content="UNDO" Command="{Binding UndoCommand}" />
                        <Button Content="{Binding RecordButtonText}" ToolTip="While on, keys played on the MIDI keyboard are recorded into the selected track" Command="{Binding ToggleRecordCommand}" />
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,0,0,4">
                        <Button Content="STOP" Command="{Binding StopCommand}" />
                        <Button Content="START" Command="{Binding PlayCommand}" />
                    </UniformGrid>
                    <Button Content="IMPORT MIDI" Command="{Binding ImportMidiCommand}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="10" Margin="2,2,2,0" />
                </StackPanel>
                </GroupBox>

                <GroupBox Header="VST PLUG-IN" Grid.Row="1" Margin="0,4,0,0" local:HelpBadge.Topic="VstPlugins">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Additional VST folder (in addition to Program Files\Common Files\VST3)" FontSize="11" Margin="0,0,0,2" TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding VstPluginsPath, Mode=OneWay}"
                                         IsReadOnly="True"
                                         ToolTip="{Binding VstPluginsPath}"
                                         Padding="2,1"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="Browse..."
                                        Margin="4,0,0,0"
                                        Command="{Binding BrowseVstPluginsPathCommand}" />
                            </Grid>
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Top"
                                   Text="No plug-ins found. Select a VST folder."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Ink}"
                                   Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VstPlugins.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Right-click: remove the plug-in under the mouse from the list, add a file or a folder,
                             or bring back removed plug-ins. The menu is built when it opens. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent"
                                      ContextMenuOpening="VstPluginList_ContextMenuOpening">
                            <ScrollViewer.ContextMenu>
                                <ContextMenu />
                            </ScrollViewer.ContextMenu>
                            <ItemsControl ItemsSource="{Binding VstPlugins}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="100"
                                                Margin="2"
                                                Background="{StaticResource Shade}"
                                                BorderBrush="{StaticResource Line}"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                ToolTip="{Binding FilePath}"
                                                ContextMenuOpening="VstPluginList_ContextMenuOpening"
                                                MouseLeftButtonDown="VstPluginThumbnail_MouseLeftButtonDown"
                                                MouseMove="VstPluginThumbnail_MouseMove"
                                                MouseLeftButtonUp="VstPluginThumbnail_MouseLeftButtonUp"
                                                AllowDrop="True"
                                                DragOver="VstPluginThumbnail_DragOver"
                                                DragLeave="VstPluginThumbnail_DragLeave"
                                                Drop="VstPluginThumbnail_Drop">
                                            <Grid>
                                                <Border Background="#343434">
                                                    <TextBlock Text="{Binding Badge}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="#59B4FF" />
                                                </Border>
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="Uniform">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <!-- A favorite's star. -->
                                                <TextBlock Text="★" FontSize="16" Foreground="#F2C94C" Margin="0,2,5,0"
                                                           HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="3" ShadowDepth="0" Color="Black" Opacity="0.9" />
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                                <Border VerticalAlignment="Bottom"
                                                        Background="#CC1A1B1D"
                                                        Padding="4,2">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextAlignment="Center"
                                                               Foreground="White" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </GroupBox>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Background="#414141"
                BorderBrush="#6C6C6C"
                BorderThickness="0,1,0,0"
                Padding="10,6,10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>


                <Slider Grid.Column="1"
                        Style="{StaticResource SongTimelineSliderStyle}"
                        Minimum="0"
                        Maximum="{Binding TimelineTotalSteps}"
                        Value="{Binding TimelinePositionStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SmallChange="1"
                        LargeChange="16"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        IsMoveToPointEnabled="True"
                        Height="26" />

                <Border Grid.Column="2"
                        Width="12"
                        Height="12"
                        Margin="10,0,0,0"
                        CornerRadius="6"
                        BorderBrush="#2D2D2D"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        ToolTip="Lights up when the MIDI keyboard sends data"
                        AutomationProperties.Name="MIDI input activity">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#2E3A2E" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMidiActivityVisible}" Value="True">
                                    <Setter Property="Background" Value="#49F07A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </Border>

        <!-- The plug-in windows put away with a click in the timeline, one button each with the instrument's name;
             a click brings the window back. Shown only while there is one. -->
        <Border x:Name="PluginDock"
                Grid.Row="4"
                Background="#333333"
                BorderBrush="#6C6C6C"
                BorderThickness="0,1,0,0"
                Padding="8,4"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="DOCK"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#ACADAF" />
                <ItemsControl x:Name="PluginDockItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,6,0"
                                    Padding="10,2"
                                    Height="24"
                                    FontSize="12"
                                    Content="{Binding Title}"
                                    Click="PluginDockButton_Click"
                                    MouseEnter="PluginDockButton_MouseEnter"
                                    MouseLeave="PluginDock_MouseLeave" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- The picture of a docked window, shown over its button as the mouse rests on it: a click on the
             picture, as on the button, brings the window back. A popup, not a tooltip, as a tooltip takes no click. -->
        <Popup x:Name="DockPreview"
               Placement="Top"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Border Background="#2A2C2F"
                    BorderBrush="#5C5E61"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Margin="0,0,0,4"
                    Cursor="Hand"
                    MouseEnter="DockPreview_MouseEnter"
                    MouseLeave="PluginDock_MouseLeave"
                    MouseLeftButtonUp="DockPreview_MouseLeftButtonUp">
                <StackPanel>
                    <Image Source="{Binding Preview}"
                           MaxWidth="210"
                           MaxHeight="150"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding Title}" FontWeight="SemiBold" Foreground="#E4E5E7" />
                    <TextBlock Text="Click to bring the window back" FontSize="11" Foreground="#ACADAF" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
