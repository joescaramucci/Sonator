                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Semibold"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#CDD6E0"
                           Margin="0,2,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#2A3748" BorderBrush="#4C657F" BorderThickness="0,0,0,1" Padding="3">
            <!-- The top bar's boxes share its width; the one with MIXER, WAVE, ARRANGE and SOUNDS gets more, to fit its four buttons. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="2" Padding="2">
                    <Button Command="{Binding ToggleLoopCommand}"
                            AutomationProperties.Name="{Binding LoopModeText, StringFormat=LOOP {0}}"
                            Padding="2,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="#263545" />
                                <Setter Property="BorderBrush" Value="#586E86" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoopEnabled}" Value="True">
                                        <Setter Property="Background" Value="#2D745D" />
                                        <Setter Property="BorderBrush" Value="#65C6A1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding LoopModeText}" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#E4ECF4" />
                            <TextBlock Text="LOOP" FontSize="11" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#C4CFDA" />
                        </StackPanel>
                    </Button>
                </Border>
                <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="2" Padding="2">
                    <Button Command="{Binding ToggleArrangeModeCommand}"
                            AutomationProperties.Name="{Binding ArrangeModeText, StringFormat=ARRANGE {0}}"
                            Padding="2,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="#263545" />
                                <Setter Property="BorderBrush" Value="#586E86" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArrangeMode}" Value="True">
                                        <Setter Property="Background" Value="#2D745D" />
                                        <Setter Property="BorderBrush" Value="#65C6A1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ArrangeModeText}" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#E4ECF4" />
                            <TextBlock Text="ARRANGE" FontSize="11" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#C4CFDA" />
                        </StackPanel>
                    </Button>
                </Border>
                <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="2" Padding="2" Cursor="Hand"
                        ToolTipService.InitialShowDelay="0"
                        ToolTipService.ShowDuration="30000"
                        ToolTip="TEMPO: double-click to type a value (1 to 999 BPM). Mouse wheel: 1 BPM per step, Shift for 0.1. Enter or click away applies it.">
                    <Border BorderBrush="#586E86" BorderThickness="1" CornerRadius="5" Padding="2" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#263545" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2F4A63" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBox Text="{Binding Tempo, StringFormat=0.000, UpdateSourceTrigger=LostFocus}" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#C4CFDA"  Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" IsReadOnly="True" Cursor="Hand" MouseDoubleClick="Tempo_MouseDoubleClick" MouseWheel="Tempo_MouseWheel" LostFocus="Tempo_LostFocus" KeyDown="Tempo_KeyDown" />
                            <TextBlock Text="TEMPO" FontSize="11" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#C4CFDA" />
                        </StackPanel>
                    </Border>
                </Border>
                <Border Grid.Column="3" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="2" Padding="2">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ToggleButton Content="ON" Width="40" Height="22" Margin="1" Style="{StaticResource MetronomeToggleStyle}"
                                          IsChecked="{Binding IsMetronomeOn}" ToolTip="Metronome on during playback" />
                            <Button Width="60" Height="22" Margin="1" ToolTip="Click to start or stop the click loop"
                                    Command="{Binding PreviewClickCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="CLICK" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsClickLoopRunning}" Value="True">
                                                <Setter Property="Content" Value="STOP" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsClickLoopRunning}" Value="False" />
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Content" Value="PLAY" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <ToggleButton Width="76" Height="22" Margin="1" FontSize="11" IsChecked="{Binding IsClickCountInOnly}"
                                          ToolTip="ALWAYS: the click goes on under the song. COUNT-IN: it counts you in, then goes quiet. Press to change.">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource MetronomeToggleStyle}">
                                        <Setter Property="Content" Value="ALWAYS" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="COUNT-IN" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <Button Width="88" Height="20" FontSize="11" Content="{Binding SelectedClickOption.Label}"
                                    Command="{Binding CycleClickOptionCommand}" ToolTip="Click on quarter notes or eighths. Press to change." />
                            <Button Width="88" Height="20" Margin="2,0,0,0" FontSize="11" Content="{Binding SelectedCountIn.Label}"
                                    Command="{Binding CycleCountInCommand}" ToolTip="Bars of clicks before recording starts. Press to change." />
                        </StackPanel>
                        <TextBlock Text="METRONOME" FontSize="11" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#C4CFDA" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="2" Padding="2" Cursor="Hand"
                        ToolTipService.InitialShowDelay="0"
                        ToolTipService.ShowDuration="30000"
                        ToolTip="SIGNATURE: click to choose the time signature. Mouse wheel: beats per bar.">
                    <Border BorderBrush="#586E86" BorderThickness="1" CornerRadius="5" Padding="2" Cursor="Hand"
                            AutomationProperties.Name="TIME SIGNATURE"
                            MouseLeftButtonUp="TimeSignature_MouseLeftButtonUp"
                            MouseWheel="TimeSignature_MouseWheel">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#263545" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2F4A63" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TimeSignature}" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#C4CFDA" />
                            <TextBlock Text="SIGNATURE" FontSize="11" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#C4CFDA" />
                        </StackPanel>
                    </Border>
                </Border>
                <!-- The song position as a large LED clock: hours, minutes and seconds. -->
                <Border Grid.Column="5" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="2" Padding="2">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Style="{StaticResource ClockPanel}">
                            <local:SevenSegmentDisplay Text="{Binding TransportPosition}" Style="{StaticResource ClockDigits}"
                                                       AutomationProperties.Name="POSITION MIN SEC" />
                        </Border>
                        <TextBlock Text="HR:MIN:SEC" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#C4CFDA" />
                    </StackPanel>
                </Border>
                <!-- The same position as bar and beat, counted from 1. -->
                <Border Grid.Column="6" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="2" Padding="2">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Style="{StaticResource ClockPanel}">
                            <local:SevenSegmentDisplay Text="{Binding CurrentStepBar}" Style="{StaticResource ClockDigits}"
                                                       AutomationProperties.Name="POSITION BARS" />
                        </Border>
                        <TextBlock Text="BAR . BEAT" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#C4CFDA" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="7" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="2" Padding="2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button Content="MIXER" Style="{StaticResource BottomTabButton}" Width="58" Margin="2,0"
                                Click="ShowMixerButton_Click" AutomationProperties.Name="Open mixer" />
                        <Button Content="WAVE" Style="{StaticResource BottomTabButton}" Width="58" Margin="2,0"
                                Click="ShowWaveformButton_Click" AutomationProperties.Name="Open waveform editor" />
                        <Button Content="ARRANGE" Style="{StaticResource BottomTabButton}" Width="72" Margin="2,0"
                                Click="ShowSongButton_Click" AutomationProperties.Name="Show song arrangement" />
                        <Button Content="SOUNDS" Style="{StaticResource BottomTabButton}" Width="66" Margin="2,0"
                                Click="ShowSoundsButton_Click" AutomationProperties.Name="Browse sounds"
                                ToolTip="Find a sound in all the plug-ins, by category or by name, and load it on the selected track (Ctrl+B)" />
                    </StackPanel>
                </Border>
                <!-- How hard the PC is working: CPU, the plug-ins' audio load with its dropouts, and memory. -->
                <Border Grid.Column="8" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="2" Padding="8,2" DataContext="{Binding Health}">
                    <Border.Resources>
                        <Style x:Key="HealthBar" TargetType="ProgressBar">
                            <Setter Property="Minimum" Value="0" />
                            <Setter Property="Maximum" Value="1" />
                            <Setter Property="Height" Value="7" />
                            <Setter Property="Margin" Value="4,0,6,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="#16202B" BorderBrush="#3A4D63" BorderThickness="1" CornerRadius="3">
                                            <Grid>
                                                <Border x:Name="PART_Track" />
                                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Foreground" Value="#C4CFDA" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </Border.Resources>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="17" />
                            <RowDefinition Height="17" />
                            <RowDefinition Height="17" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="CPU" FontWeight="Bold" ToolTip="{Binding CpuToolTip}" />
                        <ProgressBar Grid.Column="1" Style="{StaticResource HealthBar}" Value="{Binding CpuLoad, Mode=OneWay}" Foreground="{Binding CpuBrush}" ToolTip="{Binding CpuToolTip}" />
                        <TextBlock Grid.Column="2" Text="{Binding CpuText}" HorizontalAlignment="Left" ToolTip="{Binding CpuToolTip}" />

                        <TextBlock Grid.Row="1" Text="DSP" FontWeight="Bold" ToolTip="{Binding DspToolTip}" />
                        <ProgressBar Grid.Row="1" Grid.Column="1" Style="{StaticResource HealthBar}" Value="{Binding DspLoad, Mode=OneWay}" Foreground="{Binding DspBrush}" ToolTip="{Binding DspToolTip}" />
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="{Binding DspText}" ToolTip="{Binding DspToolTip}" />
                        <TextBlock Text="{Binding DropoutsText}"
                                   Margin="8,0,0,0"
                                   Cursor="Hand"
                                   AutomationProperties.Name="AUDIO DROPOUTS"
                                   ToolTip="Audio blocks that did not reach the device in time since the last reset. Click to reset."
                                   MouseLeftButtonDown="DropoutsText_MouseLeftButtonDown">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="#7F93A8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDropouts}" Value="True">
                                            <Setter Property="Foreground" Value="#F07070" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="RAM" FontWeight="Bold" ToolTip="{Binding RamToolTip}" />
                        <ProgressBar Grid.Row="2" Grid.Column="1" Style="{StaticResource HealthBar}" Value="{Binding RamLoad, Mode=OneWay}" Foreground="{Binding RamBrush}" ToolTip="{Binding RamToolTip}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RamText}" HorizontalAlignment="Left" ToolTip="{Binding RamToolTip}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="2" Background="{StaticResource Paper}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition                 Width="260" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="PATTERN" Grid.Column="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="BAR" HorizontalAlignment="Center" FontSize="11" FontFamily="Consolas" />
                        <TextBlock Grid.Column="1" Text="ARRANGE" HorizontalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" />
                        <TextBlock Grid.Column="2" Text="a" HorizontalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" />
                        <TextBlock Grid.Column="3" Text="b" HorizontalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" />
                        <TextBlock Grid.Column="4" Text="c" HorizontalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" />
                        <TextBlock Grid.Column="5" Text="d" HorizontalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BARS" VerticalAlignment="Center" FontSize="11" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SelectedArrangePatternLength, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalContentAlignment="Center"
                                     Padding="1,0" />
                            <TextBlock Grid.Column="2" Text="TRANSPOSE" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="11" />
                            <TextBox Grid.Column="3"
                                     Text="{Binding SelectedPatternTranspose, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalContentAlignment="Center"
                                     Padding="1,0" />
                        </Grid>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="START" VerticalAlignment="Center" FontSize="10" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SelectedArrangePatternStart, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Padding="1,0"
                                     HorizontalContentAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="END" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10" />
                            <TextBox Grid.Column="3"
                                     Text="{Binding SelectedArrangePatternEnd, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Padding="1,0"
                                     HorizontalContentAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LENGTH" VerticalAlignment="Center" FontSize="10" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SelectedArrangePatternLengthDisplay, UpdateSourceTrigger=LostFocus}"
                                     Padding="1,0"
                                     HorizontalContentAlignment="Center" />
                        </Grid>
                        <UniformGrid Columns="4" Margin="0,3,0,0">
                            <Button Content="&#x2191; PREV" Command="{Binding MoveArrangePatternUpCommand}" />
                            <Button Content="&#x2193; NEXT" Command="{Binding MoveArrangePatternDownCommand}" />
                            <Button Content="COPY" Command="{Binding CopyArrangePatternCommand}" />
                            <Button Content="DELETE" Command="{Binding DeleteArrangePatternCommand}" />
                        </UniformGrid>
                        <Button Content="CREATE NEW PATTERN"
                                Command="{Binding CreateArrangePatternCommand}"
                                Margin="0,3,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Height="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.28*" />
                                    <ColumnDefinition Width="1.12*" />
                                    <ColumnDefinition Width="0.62*" />
                                    <ColumnDefinition Width="0.62*" />
                                    <ColumnDefinition Width="0.62*" />
                                    <ColumnDefinition Width="0.62*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="BAR" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontFamily="Consolas" Foreground="#C4CFDA" />
                                <TextBlock Grid.Column="1" Text="ARRANGE" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" Foreground="#C4CFDA" />
                                <TextBlock Grid.Column="2" Text="a" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" Foreground="#C4CFDA" />
                                <TextBlock Grid.Column="3" Text="b" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" Foreground="#C4CFDA" />
                                <TextBlock Grid.Column="4" Text="c" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" Foreground="#C4CFDA" />
                                <TextBlock Grid.Column="5" Text="d" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" Foreground="#C4CFDA" />
                            </Grid>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                            <ItemsControl x:Name="SongArrangeRowsItemsControl"
                                          ItemsSource="{Binding VisibleSongArrangeRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34"
                                              AllowDrop="True"
                                              Cursor="Hand"
                                              DragOver="ArrangePatternRow_DragOver"
                                              Drop="ArrangePatternRow_Drop"
                                              MouseEnter="ArrangePatternRow_MouseEnter"
                                              MouseLeave="ArrangePatternRow_MouseLeave">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.28*" />
                                                <ColumnDefinition Width="1.12*" />
                                                <ColumnDefinition Width="0.62*" />
                                                <ColumnDefinition Width="0.62*" />
                                                <ColumnDefinition Width="0.62*" />
                                                <ColumnDefinition Width="0.62*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    BorderBrush="{StaticResource Line}"
                                                    BorderThickness="1"
                                                    PreviewMouseDown="ArrangeBar_PreviewMouseDown">
