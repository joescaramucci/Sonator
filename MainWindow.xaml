                        <MenuItem Header="Driver settings..." Click="DriverSettingsMenuItem_Click" />
                        <MenuItem Header="Measure latency" Click="MeasureLatencyMenuItem_Click" />
                        <MenuItem Header="Mixer..." Click="MixerMenuItem_Click" />
                        <MenuItem Header="Waveform editor..." Click="WaveformEditorMenuItem_Click" />
                    </MenuItem>
                </Menu>

                <TextBlock Text="{Binding SongTitle, StringFormat='{}{0} — SONATOR 1.0'}"
                           local:HelpBadge.Topic="Sonator"
                           Padding="0,0,22,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Semibold"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#D9DADC"
                           Margin="0,2,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource Panel.Header}" BorderBrush="#090A0C" BorderThickness="0,0,0,1" Padding="3">
            <!-- The top bar's boxes share its width; the one with MIXER, WAVE, ARRANGE and SOUNDS gets more, to fit its four buttons. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.75*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource BarCell}" local:HelpBadge.Topic="Loop" local:HelpBadge.IsSmall="True">
                    <Button Command="{Binding ToggleLoopCommand}"
                            AutomationProperties.Name="{Binding LoopModeText, StringFormat=LOOP {0}}"
                            Padding="2,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="#3D3D3D" />
                                <Setter Property="BorderBrush" Value="#757678" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoopEnabled}" Value="True">
                                        <Setter Property="Background" Value="#2D745D" />
                                        <Setter Property="BorderBrush" Value="#65C6A1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding LoopModeText}" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="LOOP" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource BarCell}" local:HelpBadge.Topic="ArrangeMode" local:HelpBadge.IsSmall="True">
                    <Button Command="{Binding ToggleArrangeModeCommand}"
                            AutomationProperties.Name="{Binding ArrangeModeText, StringFormat=ARRANGE {0}}"
                            Padding="2,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="#3D3D3D" />
                                <Setter Property="BorderBrush" Value="#757678" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArrangeMode}" Value="True">
                                        <Setter Property="Background" Value="#2D745D" />
                                        <Setter Property="BorderBrush" Value="#65C6A1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ArrangeModeText}" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="ARRANGE" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource BarCell}" Cursor="Hand" local:HelpBadge.Topic="Tempo" local:HelpBadge.IsSmall="True">
                    <Border BorderBrush="{StaticResource Inset.Edge}" BorderThickness="1" CornerRadius="4" Padding="2" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Inset.Face}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3F3F3F" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBox Text="{Binding Tempo, StringFormat=0.000, UpdateSourceTrigger=LostFocus}" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#D2D3D5"  Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" IsReadOnly="True" Cursor="Hand" MouseDoubleClick="Tempo_MouseDoubleClick" MouseWheel="Tempo_MouseWheel" LostFocus="Tempo_LostFocus" KeyDown="Tempo_KeyDown" />
                            <TextBlock Text="TEMPO" FontSize="11" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#D2D3D5" />
                        </StackPanel>
                    </Border>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource BarCell}" local:HelpBadge.Topic="Metronome" local:HelpBadge.IsSmall="True">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ToggleButton Content="ON" Width="40" Height="22" Margin="1" Style="{StaticResource MetronomeToggleStyle}"
                                          IsChecked="{Binding IsMetronomeOn}" />
                            <Button Width="60" Height="22" Margin="1"
                                    Command="{Binding PreviewClickCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="CLICK" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsClickLoopRunning}" Value="True">
                                                <Setter Property="Content" Value="STOP" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsClickLoopRunning}" Value="False" />
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Content" Value="PLAY" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <ToggleButton Width="76" Height="22" Margin="1" FontSize="11" IsChecked="{Binding IsClickCountInOnly}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource MetronomeToggleStyle}">
                                        <Setter Property="Content" Value="ALWAYS" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="COUNT-IN" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <Button Width="88" Height="20" FontSize="11" Content="{Binding SelectedClickOption.Label}"
                                    Command="{Binding CycleClickOptionCommand}" />
                            <Button Width="88" Height="20" Margin="2,0,0,0" FontSize="11" Content="{Binding SelectedCountIn.Label}"
                                    Command="{Binding CycleCountInCommand}" />
                        </StackPanel>
                        <TextBlock Text="METRONOME" FontSize="11" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#D2D3D5" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource BarCell}" Cursor="Hand" local:HelpBadge.Topic="Signature" local:HelpBadge.IsSmall="True">
                    <Border BorderBrush="#757678" BorderThickness="1" CornerRadius="5" Padding="2" Cursor="Hand"
                            AutomationProperties.Name="TIME SIGNATURE"
                            MouseLeftButtonUp="TimeSignature_MouseLeftButtonUp"
                            MouseWheel="TimeSignature_MouseWheel">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Inset.Face}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3F3F3F" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TimeSignature}" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#D2D3D5" />
                            <TextBlock Text="SIGNATURE" FontSize="11" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#D2D3D5" />
                        </StackPanel>
                    </Border>
                </Border>
                <!-- The song position as a large LED clock: hours, minutes and seconds. -->
                <Border Grid.Column="5" Style="{StaticResource BarCell}" local:HelpBadge.Topic="Clock" local:HelpBadge.IsSmall="True">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Style="{StaticResource ClockPanel}">
                            <local:SevenSegmentDisplay Text="{Binding TransportPosition}" Style="{StaticResource ClockDigits}"
                                                       AutomationProperties.Name="POSITION MIN SEC" />
                        </Border>
                        <TextBlock Text="HR:MIN:SEC" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#D2D3D5" />
                    </StackPanel>
                </Border>
                <!-- The same position as bar and beat, counted from 1. -->
                <Border Grid.Column="6" Style="{StaticResource BarCell}" local:HelpBadge.Topic="Clock" local:HelpBadge.IsSmall="True">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Style="{StaticResource ClockPanel}">
                            <local:SevenSegmentDisplay Text="{Binding CurrentStepBar}" Style="{StaticResource ClockDigits}"
                                                       AutomationProperties.Name="POSITION BARS" />
                        </Border>
                        <TextBlock Text="BAR . BEAT" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#D2D3D5" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="7" Style="{StaticResource BarCell}" local:HelpBadge.Topic="Views" local:HelpBadge.IsSmall="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button Content="MIXER" Style="{StaticResource BottomTabButton}" Width="58" Margin="2,0"
                                Click="ShowMixerButton_Click" AutomationProperties.Name="Open mixer" />
                        <Button Content="WAVE" Style="{StaticResource BottomTabButton}" Width="58" Margin="2,0"
                                Click="ShowWaveformButton_Click" AutomationProperties.Name="Open waveform editor" />
                        <Button Content="ARRANGE" Width="72" Margin="2,0"
                                Click="ShowSongButton_Click" AutomationProperties.Name="Show song arrangement">
                            <!-- Lit while the whole song plays (arrange mode), as the ARRANGE box says ON. -->
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BottomTabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsArrangeMode}" Value="True">
                                            <Setter Property="Background" Value="#2D745D" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="SOUNDS" Style="{StaticResource BottomTabButton}" Width="66" Margin="2,0"
                                Click="ShowSoundsButton_Click" AutomationProperties.Name="Browse sounds"
                                ToolTip="Find a sound in all the plug-ins, by category or by name, and load it on the selected track (Ctrl+B)" />
                        <Button Content="SCORE" Style="{StaticResource BottomTabButton}" Width="58" Margin="2,0"
                                Click="ShowScoreButton_Click" AutomationProperties.Name="Open Cromator, the score" />
                    </StackPanel>
                </Border>
                <!-- How hard the PC is working: CPU, the plug-ins' audio load with its dropouts, and memory. -->
                <Border Grid.Column="8" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="2" Padding="8,2" DataContext="{Binding Health}"
                        local:HelpBadge.Topic="Health" local:HelpBadge.IsSmall="True">
                    <Border.Resources>
                        <Style x:Key="HealthBar" TargetType="ProgressBar">
                            <Setter Property="Minimum" Value="0" />
                            <Setter Property="Maximum" Value="1" />
                            <Setter Property="Height" Value="7" />
                            <Setter Property="Margin" Value="4,0,6,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="#292929" BorderBrush="#555555" BorderThickness="1" CornerRadius="3">
                                            <Grid>
                                                <Border x:Name="PART_Track" />
                                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Foreground" Value="#D2D3D5" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </Border.Resources>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="17" />
                            <RowDefinition Height="17" />
                            <RowDefinition Height="17" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="CPU" FontWeight="Bold" ToolTip="{Binding CpuToolTip}" />
                        <ProgressBar Grid.Column="1" Style="{StaticResource HealthBar}" Value="{Binding CpuLoad, Mode=OneWay}" Foreground="{Binding CpuBrush}" ToolTip="{Binding CpuToolTip}" />
                        <TextBlock Grid.Column="2" Text="{Binding CpuText}" HorizontalAlignment="Left" ToolTip="{Binding CpuToolTip}" />

                        <TextBlock Grid.Row="1" Text="DSP" FontWeight="Bold" ToolTip="{Binding DspToolTip}" />
                        <ProgressBar Grid.Row="1" Grid.Column="1" Style="{StaticResource HealthBar}" Value="{Binding DspLoad, Mode=OneWay}" Foreground="{Binding DspBrush}" ToolTip="{Binding DspToolTip}" />
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="{Binding DspText}" ToolTip="{Binding DspToolTip}" />
                        <TextBlock Text="{Binding DropoutsText}"
                                   Margin="8,0,0,0"
                                   Cursor="Hand"
                                   AutomationProperties.Name="AUDIO DROPOUTS"
                                   ToolTip="Audio blocks that did not reach the device in time since the last reset. Click to reset."
                                   MouseLeftButtonDown="DropoutsText_MouseLeftButtonDown">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="#98999B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDropouts}" Value="True">
                                            <Setter Property="Foreground" Value="#F07070" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="RAM" FontWeight="Bold" ToolTip="{Binding RamToolTip}" />
                        <ProgressBar Grid.Row="2" Grid.Column="1" Style="{StaticResource HealthBar}" Value="{Binding RamLoad, Mode=OneWay}" Foreground="{Binding RamBrush}" ToolTip="{Binding RamToolTip}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RamText}" HorizontalAlignment="Left" ToolTip="{Binding RamToolTip}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="2" Background="{StaticResource Paper}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition                 Width="260" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="PATTERN" Grid.Column="0" local:HelpBadge.Topic="Pattern">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="BAR" HorizontalAlignment="Center" FontSize="11" FontFamily="Consolas" />
                        <TextBlock Grid.Column="1" Text="ARRANGE" HorizontalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" />
                        <TextBlock Grid.Column="2" Text="a" HorizontalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" />
                        <TextBlock Grid.Column="3" Text="b" HorizontalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" />
                        <TextBlock Grid.Column="4" Text="c" HorizontalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" />
                        <TextBlock Grid.Column="5" Text="d" HorizontalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
