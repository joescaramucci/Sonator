<Window x:Class="Sonator.SonatorMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sonator"
        Width="460"
        Height="210"
        Background="#1B2330"
        Foreground="#C4CFDA"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A3948" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#354D69" />
                    <Setter Property="BorderBrush" Value="#7EB2FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding DialogTitle}"
                   FontFamily="Segoe UI Semibold"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,0,0,10" />

        <Border Grid.Row="1"
                Background="#212D3A"
                BorderBrush="#607A96"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">
            <TextBlock Text="{Binding Message}"
                       TextWrapping="Wrap" />
        </Border>

        <Button x:Name="OkButton"
                Grid.Row="2"
                Content="OK"
                Width="92"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                IsDefault="True"
                IsCancel="True"
                Click="OkButton_Click" />

        <StackPanel x:Name="SaveChoicePanel"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0"
                    Visibility="Collapsed">
            <Button Content="SAVE" Width="92" Margin="0,0,8,0" IsDefault="True" Click="SaveButton_Click" />
            <Button Content="DON'T SAVE" Width="104" Margin="0,0,8,0" Click="DontSaveButton_Click" />
            <Button Content="CANCEL" Width="92" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
