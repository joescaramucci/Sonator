<Application x:Class="Sonator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sonator.ViewModels"
             xmlns:local="clr-namespace:Sonator"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- An instrument icon, drawn in the surrounding text colour and scaled to whatever size holds it. -->
        <DataTemplate DataType="{x:Type vm:InstrumentIcon}">
            <Viewbox Stretch="Uniform">
                <Canvas Width="24" Height="24">
                    <Path Data="{Binding Strokes}"
                          Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                          StrokeThickness="1.6"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                    <Path Data="{Binding Fills}"
                          Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- ==== The 3D look, in the manner of hardware panels such as SSL's ====
             Light falls from above: a raised control is lit at its top edge and shaded at its bottom, and casts a
             short shadow on the panel; pressed or switched on, it sinks in. The control keeps its own colour
             (Background) under the light, so a green lit button or a red record button stay what they are. -->
        <LinearGradientBrush x:Key="Bevel.Sheen" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40FFFFFF" Offset="0" />
            <GradientStop Color="#12FFFFFF" Offset="0.45" />
            <GradientStop Color="#00000000" Offset="0.55" />
            <GradientStop Color="#47000000" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Bevel.Pressed" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#66000000" Offset="0" />
            <GradientStop Color="#1F000000" Offset="0.35" />
            <GradientStop Color="#0DFFFFFF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Bevel.Lit" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40000000" Offset="0" />
            <GradientStop Color="#00000000" Offset="0.3" />
            <GradientStop Color="#26FFFFFF" Offset="0.85" />
            <GradientStop Color="#10FFFFFF" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Bevel.Rim" Color="#73FFFFFF" />
        <SolidColorBrush x:Key="Bevel.RimHot" Color="#C0FFFFFF" />
        <SolidColorBrush x:Key="Bevel.Outline" Color="#0E0F11" />
        <SolidColorBrush x:Key="Bevel.CastShadow" Color="#99000000" />

        <local:LampConverter x:Key="Lamp" />

        <!-- ==== SSL's keycap buttons ====
             A keycap standing in a narrow anthracite well cut into the panel, casting a soft shadow below it. The
             cap's top face is satin grey, a touch lighter at the top where a faint sheen catches the light, with a
             fine light edge; its front shows below the face as a darker band. Hovered, the face brightens a little.
             Pressed, the cap goes down into the well, its front side hides and the face darkens. Switched on, the
             face lights in the button's colour under a glass and the light spills into the well; the label turns
             dark. Tag "LightCap" gives a light top face with a dark label, as SSL's power switches. -->
        <LinearGradientBrush x:Key="Key.Well" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#45474A" Offset="0" />
            <GradientStop Color="#3A3C3F" Offset="0.6" />
            <GradientStop Color="#333538" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Key.Shadow" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#30000000" Offset="0.7" />
            <GradientStop Color="#48000000" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Key.Body" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6A6C6F" Offset="0" />
            <GradientStop Color="#4A4C4F" Offset="0.8" />
            <GradientStop Color="#3C3E41" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Key.Face" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7A7C7F" Offset="0" />
            <GradientStop Color="#6B6D70" Offset="0.45" />
            <GradientStop Color="#626467" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Key.FaceLight" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D6D7D9" Offset="0" />
            <GradientStop Color="#C3C5C7" Offset="0.55" />
            <GradientStop Color="#B5B7B9" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Key.FacePressed" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#535558" Offset="0" />
            <GradientStop Color="#5E6063" Offset="1" />
        </LinearGradientBrush>
        <!-- The satin sheen on a cap's face: a soft light on its upper half, gone by the middle. -->
        <LinearGradientBrush x:Key="Key.Sheen" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CFFFFFF" Offset="0" />
            <GradientStop Color="#0CFFFFFF" Offset="0.45" />
            <GradientStop Color="#00FFFFFF" Offset="0.5" />
            <GradientStop Color="#00000000" Offset="0.8" />
            <GradientStop Color="#14000000" Offset="1" />
        </LinearGradientBrush>
        <!-- A lit cap's glass: brightest at its middle, as a bulb behind it. -->
        <RadialGradientBrush x:Key="Lamp.Glass" GradientOrigin="0.5,0.45" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.8">
            <GradientStop Color="#D0FFFFF0" Offset="0" />
            <GradientStop Color="#50FFFFFF" Offset="0.45" />
            <GradientStop Color="#00FFFFFF" Offset="0.8" />
            <GradientStop Color="#30000000" Offset="1" />
        </RadialGradientBrush>

        <ControlTemplate x:Key="Raised3D" TargetType="ButtonBase">
            <Grid x:Name="Root" SnapsToDevicePixels="True">
                <!-- The soft shadow the key casts on the panel below it, the well, and the lamp's light spilling into it. -->
                <Border x:Name="Shadow" CornerRadius="5" Margin="-0.5,1,-0.5,-2" Background="{StaticResource Key.Shadow}" />
                <Border CornerRadius="3.5" Background="{StaticResource Key.Well}" BorderBrush="#30FFFFFF" BorderThickness="0,0,0,0.6" />
                <Border x:Name="Spill" CornerRadius="3.5" Margin="0.5" Opacity="0.75">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource Lamp}" ConverterParameter="brush">
                            <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="(ToggleButton.IsChecked)" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                    </Border.Background>
                    <Border.Effect>
                        <BlurEffect Radius="5" />
                    </Border.Effect>
                </Border>
                <!-- The keycap: its body (the front side shows as the darker band under the face), then its face. -->
                <Grid x:Name="Cap" Margin="1,0.8,1,1.8">
                    <Border CornerRadius="2.8" Background="{StaticResource Key.Body}" BorderBrush="#323437" BorderThickness="0.5" />
                    <Border x:Name="Face" CornerRadius="2.3" Margin="0.9,0.9,0.9,2.6" Background="{StaticResource Key.Face}" />
                    <!-- The lamp: the face lit in the button's colour, under its glass. -->
                    <Border x:Name="LampFace" CornerRadius="2.3" Margin="0.9,0.9,0.9,2.6">
                        <Border.Opacity>
                            <MultiBinding Converter="{StaticResource Lamp}" ConverterParameter="opacity">
                                <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}" />
                                <Binding Path="(ToggleButton.IsChecked)" RelativeSource="{RelativeSource TemplatedParent}" />
                            </MultiBinding>
                        </Border.Opacity>
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource Lamp}" ConverterParameter="brush">
                                <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}" />
                                <Binding Path="(ToggleButton.IsChecked)" RelativeSource="{RelativeSource TemplatedParent}" />
                            </MultiBinding>
                        </Border.Background>
                        <Border CornerRadius="2.3" Background="{StaticResource Lamp.Glass}" />
                    </Border>
                    <Border x:Name="Sheen" CornerRadius="2.3" Margin="0.9,0.9,0.9,2.6" Background="{StaticResource Key.Sheen}" />
                    <Border x:Name="Hover" CornerRadius="2.3" Margin="0.9,0.9,0.9,2.6" Background="#16FFFFFF" Opacity="0" />
                    <Border x:Name="Edge" CornerRadius="2.5" Margin="0.9,0.9,0.9,0" BorderThickness="0,0.8,0,0" BorderBrush="#80FFFFFF" />
                    <Border x:Name="FaceArea" Margin="0.9,0.9,0.9,2.6">
                    <ContentPresenter x:Name="Content"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextElement.FontFamily="Segoe UI, Segoe UI Symbol"
                                      TextElement.FontWeight="Normal"
                                      RecognizesAccessKey="True">
                        <TextElement.Foreground>
                            <MultiBinding Converter="{StaticResource Lamp}" ConverterParameter="ink">
                                <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}" />
                                <Binding Path="(ToggleButton.IsChecked)" RelativeSource="{RelativeSource TemplatedParent}" />
                                <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}" />
                            </MultiBinding>
                        </TextElement.Foreground>
                        <ContentPresenter.Effect>
                            <DropShadowEffect ShadowDepth="0.7" Direction="270" BlurRadius="1" Color="Black" Opacity="0.45" />
                        </ContentPresenter.Effect>
                    </ContentPresenter>
                    </Border>
                </Grid>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="LightCap">
                    <Setter TargetName="Face" Property="Background" Value="{StaticResource Key.FaceLight}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Hover" Property="Opacity" Value="1" />
                    <Setter TargetName="Edge" Property="BorderBrush" Value="#B0FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Cap" Property="Margin" Value="1,1.8,1,0.8" />
                    <Setter TargetName="Face" Property="Margin" Value="0.9,0.9,0.9,1.1" />
                    <Setter TargetName="LampFace" Property="Margin" Value="0.9,0.9,0.9,1.1" />
                    <Setter TargetName="Sheen" Property="Margin" Value="0.9,0.9,0.9,1.1" />
                    <Setter TargetName="Hover" Property="Margin" Value="0.9,0.9,0.9,1.1" />
                    <Setter TargetName="FaceArea" Property="Margin" Value="0.9,0.9,0.9,1.1" />
                    <Setter TargetName="Face" Property="Background" Value="{StaticResource Key.FacePressed}" />
                    <Setter TargetName="Sheen" Property="Opacity" Value="0.35" />
                    <Setter TargetName="Edge" Property="BorderBrush" Value="#30FFFFFF" />
                    <Setter TargetName="Shadow" Property="Opacity" Value="0.4" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <!-- A panel's face: lit at the top, a little darker at the bottom. -->
        <LinearGradientBrush x:Key="Panel.Face" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#383838" Offset="0" />
            <GradientStop Color="#2D2D2D" Offset="1" />
        </LinearGradientBrush>
        <!-- A panel's title strip, like the engraved header of a hardware module. -->
        <LinearGradientBrush x:Key="Panel.Header" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5D5D5D" Offset="0" />
            <GradientStop Color="#424242" Offset="0.5" />
            <GradientStop Color="#3A3A3A" Offset="1" />
        </LinearGradientBrush>
        <!-- The edge of something sunk into the panel: dark above, where the light cannot reach, light below. -->
        <LinearGradientBrush x:Key="Inset.Edge" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#090A0C" Offset="0" />
            <GradientStop Color="#2A2A2A" Offset="0.5" />
            <GradientStop Color="#5F738A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Inset.Face" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#151618" Offset="0" />
            <GradientStop Color="#292929" Offset="0.25" />
            <GradientStop Color="#2F2F2F" Offset="1" />
        </LinearGradientBrush>

        <!-- Dark rounded drop-downs, for the windows that have no drop-down style of their own. -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#3D3D3D" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#757678" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,4,4,4" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontFamily" Value="Consolas" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Background" Value="#333333" />
                        <Setter Property="Foreground" Value="#D2D3D5" />
                        <Setter Property="Padding" Value="6,3" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#595959" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2D745D" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid><Border CornerRadius="4" Background="{StaticResource Bevel.CastShadow}" Margin="0,1,0,-2" /><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Bevel.Outline}" BorderThickness="1" CornerRadius="4" /><Border CornerRadius="3" Margin="1" Background="{StaticResource Bevel.Sheen}" /><Border CornerRadius="3" Margin="1" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Bevel.Rim}" /><Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#D2D3D5" /></Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Body" Property="Background" Value="#515151" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Body" Property="Background" Value="#515151" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Margin="0,2,0,0"
                                        Background="#333333"
                                        BorderBrush="#757678"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}" />

        <!-- Dark scroll bars everywhere (windows, lists, drop-downs, plug-in windows) instead of the white Windows default. -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#636363" CornerRadius="4" Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#5A728D" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#6F8BA8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="MinHeight" Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The small square where a vertical and a horizontal scroll bar meet. -->
        <Style TargetType="ScrollViewer">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2D2D2D" />
            </Style.Resources>
        </Style>
    </Application.Resources>
</Application>
