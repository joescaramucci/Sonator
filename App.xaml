<Application x:Class="Sonator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sonator.ViewModels"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- An instrument icon, drawn in the surrounding text colour and scaled to whatever size holds it. -->
        <DataTemplate DataType="{x:Type vm:InstrumentIcon}">
            <Viewbox Stretch="Uniform">
                <Canvas Width="24" Height="24">
                    <Path Data="{Binding Strokes}"
                          Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                          StrokeThickness="1.6"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                    <Path Data="{Binding Fills}"
                          Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- ==== The 3D look, in the manner of hardware panels such as SSL's ====
             Light falls from above: a raised control is lit at its top edge and shaded at its bottom, and casts a
             short shadow on the panel; pressed or switched on, it sinks in. The control keeps its own colour
             (Background) under the light, so a green lit button or a red record button stay what they are. -->
        <LinearGradientBrush x:Key="Bevel.Sheen" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40FFFFFF" Offset="0" />
            <GradientStop Color="#12FFFFFF" Offset="0.45" />
            <GradientStop Color="#00000000" Offset="0.55" />
            <GradientStop Color="#47000000" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Bevel.Pressed" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#66000000" Offset="0" />
            <GradientStop Color="#1F000000" Offset="0.35" />
            <GradientStop Color="#0DFFFFFF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Bevel.Lit" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40000000" Offset="0" />
            <GradientStop Color="#00000000" Offset="0.3" />
            <GradientStop Color="#26FFFFFF" Offset="0.85" />
            <GradientStop Color="#10FFFFFF" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Bevel.Rim" Color="#73FFFFFF" />
        <SolidColorBrush x:Key="Bevel.RimHot" Color="#C0FFFFFF" />
        <SolidColorBrush x:Key="Bevel.Outline" Color="#0A0D11" />
        <SolidColorBrush x:Key="Bevel.CastShadow" Color="#99000000" />

        <!-- A raised push-button or switch. Its Background is its colour; Padding and the content alignments are
             honoured. -->
        <ControlTemplate x:Key="Raised3D" TargetType="ButtonBase">
            <Grid x:Name="Root" SnapsToDevicePixels="True">
                <Border x:Name="Shadow" CornerRadius="4" Background="{StaticResource Bevel.CastShadow}" Margin="0,1,0,-2" />
                <Border x:Name="Body" CornerRadius="4" Background="{TemplateBinding Background}"
                        BorderBrush="{StaticResource Bevel.Outline}" BorderThickness="1" />
                <Border x:Name="Sheen" CornerRadius="3" Margin="1" Background="{StaticResource Bevel.Sheen}" />
                <Border x:Name="Rim" CornerRadius="3" Margin="1" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Bevel.Rim}" />
                <ContentPresenter x:Name="Content"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Rim" Property="BorderBrush" Value="{StaticResource Bevel.RimHot}" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                    <Setter TargetName="Sheen" Property="Background" Value="{StaticResource Bevel.Lit}" />
                    <Setter TargetName="Rim" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="Shadow" Property="Margin" Value="0,0,0,-1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Sheen" Property="Background" Value="{StaticResource Bevel.Pressed}" />
                    <Setter TargetName="Rim" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="Shadow" Property="Margin" Value="0" />
                    <Setter TargetName="Content" Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="1" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- A panel's face: lit at the top, a little darker at the bottom. -->
        <LinearGradientBrush x:Key="Panel.Face" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#26303D" Offset="0" />
            <GradientStop Color="#1C2530" Offset="1" />
        </LinearGradientBrush>
        <!-- A panel's title strip, like the engraved header of a hardware module. -->
        <LinearGradientBrush x:Key="Panel.Header" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#46566A" Offset="0" />
            <GradientStop Color="#2D3A4A" Offset="0.5" />
            <GradientStop Color="#253141" Offset="1" />
        </LinearGradientBrush>
        <!-- The edge of something sunk into the panel: dark above, where the light cannot reach, light below. -->
        <LinearGradientBrush x:Key="Inset.Edge" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#05080B" Offset="0" />
            <GradientStop Color="#1A222C" Offset="0.5" />
            <GradientStop Color="#5F738A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Inset.Face" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0D131A" Offset="0" />
            <GradientStop Color="#18212C" Offset="0.25" />
            <GradientStop Color="#1C2633" Offset="1" />
        </LinearGradientBrush>

        <!-- Dark rounded drop-downs, for the windows that have no drop-down style of their own. -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#263545" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="BorderBrush" Value="#586E86" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,4,4,4" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontFamily" Value="Consolas" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Background" Value="#1F2A38" />
                        <Setter Property="Foreground" Value="#C4CFDA" />
                        <Setter Property="Padding" Value="6,3" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#3A4F68" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2D745D" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid><Border CornerRadius="4" Background="{StaticResource Bevel.CastShadow}" Margin="0,1,0,-2" /><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Bevel.Outline}" BorderThickness="1" CornerRadius="4" /><Border CornerRadius="3" Margin="1" Background="{StaticResource Bevel.Sheen}" /><Border CornerRadius="3" Margin="1" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Bevel.Rim}" /><Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#C4CFDA" /></Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Body" Property="Background" Value="#2F4A63" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Body" Property="Background" Value="#2F4A63" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Margin="0,2,0,0"
                                        Background="#1F2A38"
                                        BorderBrush="#586E86"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}" />

        <!-- Dark scroll bars everywhere (windows, lists, drop-downs, plug-in windows) instead of the white Windows default. -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#485B72" CornerRadius="4" Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#5A728D" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#6F8BA8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="#1B2330" />
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="MinHeight" Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The small square where a vertical and a horizontal scroll bar meet. -->
        <Style TargetType="ScrollViewer">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1B2330" />
            </Style.Resources>
        </Style>
    </Application.Resources>
</Application>
