<Window x:Class="Sonator.NormalizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sonator"
        Title="SonNormalize"
        SizeToContent="WidthAndHeight"
        Background="#2D2D2D"
        Foreground="#D2D3D5"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#414141" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#575757" />
                    <Setter Property="BorderBrush" Value="#7EB2FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14">
        <TextBlock Text="SonNormalize" FontFamily="Segoe UI Semibold" FontSize="20" Foreground="#EFF0F2" />
        <TextBlock Text="{Binding Subtitle}" Foreground="#98999B" FontSize="11" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal">
            <Border Width="110" Padding="4,6" CornerRadius="6" Background="#353535" BorderBrush="#474747" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Peak now" HorizontalAlignment="Center" FontSize="11" Foreground="#B9BABC" />
                    <TextBlock Text="{Binding CurrentPeakText}" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Margin="0,18,0,18" />
                </StackPanel>
            </Border>
            <TextBlock Text="→" FontSize="22" VerticalAlignment="Center" Margin="12,0" />
            <Border Width="110" Padding="4,6" CornerRadius="6" Background="#353535" BorderBrush="#474747" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Target peak" HorizontalAlignment="Center" FontSize="11" Foreground="#B9BABC" />
                    <local:Knob Width="52" Height="52" Margin="0,4" Accent="#5CAFD6"
                                Position="{Binding TargetPosition}" DefaultPosition="{Binding DefaultTargetPosition}"
                                AutomationProperties.Name="TARGET PEAK"
                                ToolTip="Drag up or down, mouse wheel, double-click for -0.3 dB" />
                    <TextBlock Text="{Binding TargetText}" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#EFF0F2" />
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock Text="{Binding GainText}" Margin="0,12,0,0" Foreground="#B9BABC" />
        <TextBlock Text="The original file is kept; the track gets a normalized copy." Margin="0,2,0,0" Foreground="#98999B" FontSize="11" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="CANCEL" Width="92" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="APPLY" Width="92" IsDefault="True" Click="Apply_Click" />
        </StackPanel>
    </StackPanel>
</Window>
