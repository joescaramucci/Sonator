<Window x:Class="Sonator.InstrumentIconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instrument icon"
        Width="560"
        SizeToContent="Height"
        Background="#28292B"
        Foreground="#D2D3D5"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="#3D3E40" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555658" />
                    <Setter Property="BorderBrush" Value="#7EB2FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconChoiceButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="72" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="#303133" />
            <Setter Property="BorderBrush" Value="#535456" />
            <Setter Property="Foreground" Value="#E4E5E7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="BorderBrush" Value="#E6C45B" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555658" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="14">
        <TextBlock Text="{Binding Heading}"
                   FontFamily="Segoe UI Semibold"
                   FontSize="14"
                   Margin="0,0,0,10" />

        <ItemsControl ItemsSource="{Binding Choices}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource IconChoiceButton}"
                            ToolTip="{Binding Icon.Name}"
                            AutomationProperties.Name="{Binding Icon.Name}"
                            Click="IconChoice_Click">
                        <StackPanel>
                            <ContentControl Content="{Binding Icon}" Width="34" Height="34" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Icon.Name}"
                                       FontSize="10"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="NO ICON" Width="92" Margin="0,0,8,0" Style="{StaticResource DialogButton}" Click="NoIcon_Click" />
            <Button Content="CANCEL" Width="92" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
