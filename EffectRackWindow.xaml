<Window x:Class="Sonator.EffectRackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sonator"
        Title="{Binding WindowTitle}"
        Width="840"
        SizeToContent="Height"
        Background="#1B2330"
        Foreground="#C4CFDA"
        FontFamily="Consolas"
        ResizeMode="CanMinimize"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="RackButton" TargetType="ButtonBase">
            <Setter Property="Background" Value="#2A3948" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#354D69" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                    <Setter Property="Background" Value="#2D9A6E" />
                    <Setter Property="Foreground" Value="#0F1A14" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,10,14,14">
        <!-- The rack's title, and + ADD to put another effect at the bottom of it. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource RackButton}" Content="+ ADD" Click="Add_Click"
                    AutomationProperties.Name="ADD EFFECT" ToolTip="Add an effect at the bottom of the rack" />
            <StackPanel>
                <TextBlock Text="FX RACK" FontFamily="Segoe UI Semibold" FontSize="20" Foreground="#E8EEF4" />
                <TextBlock Text="{Binding Subtitle}" Foreground="#7F93A8" FontSize="11" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="The rack is empty. Press + ADD to put an effect in it." Foreground="#7F93A8" Margin="2,6">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Track.Effects.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer x:Name="RackScroller" MaxHeight="{Binding MaxRackHeight}" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Track.Effects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- One effect of the rack: its switch, name and controls on top, its knobs below. -->
                        <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="6" Background="{StaticResource Panel.Face}" BorderBrush="{StaticResource Bevel.Outline}" BorderThickness="1"
                                AllowDrop="True" DragOver="Module_DragOver" DragLeave="Module_DragLeave" Drop="Module_Drop">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="⠿"
                                               FontSize="18"
                                               Foreground="#7F93A8"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Cursor="SizeAll"
                                               Background="Transparent"
                                               ToolTip="Drag to move the effect up or down the rack"
                                               PreviewMouseLeftButtonDown="Grip_PreviewMouseLeftButtonDown"
                                               PreviewMouseMove="Grip_PreviewMouseMove" />
                                    <ToggleButton DockPanel.Dock="Left"
                                                  Style="{StaticResource RackButton}"
                                                  Width="48"
                                                  IsChecked="{Binding IsEnabled}"
                                                  Content="ON"
                                                  AutomationProperties.Name="EFFECT ON"
                                                  ToolTip="Switch the effect on or off" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <!-- The preset: choosing one sets every knob; SAVE keeps the current knobs under a name. -->
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasKnobs, Converter={StaticResource VisibleWhenTrue}}">
                                            <TextBlock Text="modified" FontSize="10" Foreground="#E6C45B" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       ToolTip="A knob has moved since the preset was chosen"
                                                       Visibility="{Binding IsPresetModified, Converter={StaticResource VisibleWhenTrue}}" />
                                            <ComboBox Width="200"
                                                      Height="24"
                                                      ItemsSource="{Binding Presets}"
                                                      SelectedItem="{Binding SelectedPreset}"
                                                      DisplayMemberPath="DisplayName"
                                                      AutomationProperties.Name="PRESET"
                                                      ToolTip="Presets: Sonator's, then yours (★)" />
                                            <Button Style="{StaticResource RackButton}" Content="SAVE" Margin="4,0,8,0" Click="SavePreset_Click"
                                                    AutomationProperties.Name="SAVE PRESET" ToolTip="Save the current knobs as a preset, with a name" />
                                        </StackPanel>
                                        <!-- A VST3 effect is set in its own window. -->
                                        <Button Style="{StaticResource RackButton}" Content="EDIT" Margin="0,0,8,0" Click="EditPlugin_Click"
                                                Visibility="{Binding IsPlugin, Converter={StaticResource VisibleWhenTrue}}"
                                                AutomationProperties.Name="EDIT PLUG-IN" ToolTip="Open the plug-in's window" />
                                        <Button Style="{StaticResource RackButton}" Content="▲" Margin="4,0,0,0" Tag="-1" Click="Move_Click" ToolTip="Move up the rack (earlier in the chain)" />
                                        <Button Style="{StaticResource RackButton}" Content="▼" Margin="4,0,0,0" Tag="1" Click="Move_Click" ToolTip="Move down the rack (later in the chain)" />
                                        <Button Style="{StaticResource RackButton}" Content="RESET" Margin="4,0,0,0" Click="Reset_Click" ToolTip="Put every knob back to its default"
                                                Visibility="{Binding HasKnobs, Converter={StaticResource VisibleWhenTrue}}" />
                                        <Button Style="{StaticResource RackButton}" Content="✕" Margin="4,0,0,0" Click="Remove_Click" ToolTip="Remove the effect from the rack" AutomationProperties.Name="REMOVE EFFECT" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Background="Transparent" Cursor="SizeAll"
                                                ToolTip="Drag to move the effect up or down the rack"
                                                PreviewMouseLeftButtonDown="Grip_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="Grip_PreviewMouseMove">
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold" FontSize="16" Foreground="#E8EEF4" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Definition.Description}" Foreground="#7F93A8" FontSize="11" Margin="10,3,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="not found on this computer: the sound passes through" Foreground="#E6C45B" FontSize="11" Margin="10,3,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsPluginMissing, Converter={StaticResource VisibleWhenTrue}}" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,2,8,2" Visibility="{Binding HasLevelMeters, Converter={StaticResource VisibleWhenTrue}}"
                                                ToolTip="The level going into the effect">
                                        <local:LedMeter Width="10" Height="96" Segments="16" HorizontalAlignment="Center" Level="{Binding InputLevel}" />
                                        <TextBlock Text="IN" FontSize="10" Foreground="#9FB4C9" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,2,0,2" Visibility="{Binding HasLevelMeters, Converter={StaticResource VisibleWhenTrue}}"
                                                ToolTip="The level coming out of the effect">
                                        <local:LedMeter Width="10" Height="96" Segments="16" HorizontalAlignment="Center" Level="{Binding OutputLevel}" />
                                        <TextBlock Text="OUT" FontSize="10" Foreground="#9FB4C9" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                    </StackPanel>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Parameters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="82" Margin="2" Padding="3,5" CornerRadius="5" Background="#141B24" BorderBrush="{StaticResource Inset.Edge}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="11" Foreground="#9FB4C9" />
                                                    <Grid Height="50" Margin="0,3">
                                                        <local:Knob Width="46" Height="46"
                                                                    Position="{Binding Position}"
                                                                    DefaultPosition="{Binding DefaultPosition}"
                                                                    Look="Console"
                                                                    Accent="#3A7BD5"
                                                                    AutomationProperties.Name="{Binding Name}"
                                                                    ToolTip="Drag up or down (Shift for fine), mouse wheel, double-click for the default">
                                                            <local:Knob.Style>
                                                                <Style TargetType="local:Knob">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Definition.IsSwitch}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </local:Knob.Style>
                                                        </local:Knob>
                                                        <ToggleButton Width="58"
                                                                      VerticalAlignment="Center"
                                                                      IsChecked="{Binding IsOn}"
                                                                      Content="{Binding DisplayValue}"
                                                                      AutomationProperties.Name="{Binding Name}">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource RackButton}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Definition.IsSwitch}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>
                                                    </Grid>
                                                    <TextBlock Text="{Binding DisplayValue}" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#E8EEF4">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Definition.IsSwitch}" Value="True">
                                                                        <Setter Property="Visibility" Value="Hidden" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </Grid>

                                <!-- Gain reduction, for the compressor and the limiter. -->
                                <StackPanel Margin="2,8,2,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMeter}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <DockPanel>
                                        <TextBlock Text="GAIN REDUCTION" FontSize="11" Foreground="#9FB4C9" />
                                        <TextBlock Text="{Binding MeterText}" HorizontalAlignment="Right" FontWeight="Bold" />
                                    </DockPanel>
                                    <ProgressBar Height="7" Margin="0,3,0,0" Minimum="0" Maximum="24" Value="{Binding MeterValue, Mode=OneWay}"
                                                 Background="#16202B" BorderBrush="#3A4D63" Foreground="#E6C45B" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
