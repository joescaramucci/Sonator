<Window x:Class="Sonator.TimeSignatureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time signature"
        Width="420"
        SizeToContent="Height"
        Background="#2D2D2D"
        Foreground="#D2D3D5"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#414141" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#575757" />
                    <Setter Property="BorderBrush" Value="#7EB2FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="14">
        <TextBlock Text="Choose the time signature" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,0,10" />

        <ItemsControl ItemsSource="{Binding Presets}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding}" Margin="2" Click="Preset_Click" AutomationProperties.Name="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Or any other:" Margin="0,12,0,6" />
        <StackPanel Orientation="Horizontal">
            <ComboBox x:Name="NumeratorBox" Width="70" ItemsSource="{Binding Numerators}" AutomationProperties.Name="BEATS PER BAR" />
            <TextBlock Text="/" FontSize="18" FontWeight="Bold" Margin="10,0" />
            <ComboBox x:Name="DenominatorBox" Width="70" ItemsSource="{Binding Denominators}" AutomationProperties.Name="BEAT NOTE" />
            <TextBlock Text="beats per bar / note of the beat" Foreground="#98999B" FontSize="11" Margin="12,0,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="CANCEL" Width="92" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="OK" Width="92" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
