<Window x:Class="Sonator.SondyneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sonator"
        Title="Sondyne"
        Width="1300"
        Height="760"
        Background="#2D2D2D"
        Foreground="#D2D3D5"
        FontFamily="Consolas"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#414141" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#575757" />
                    <Setter Property="BorderBrush" Value="#7EB2FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="14,0,6,0" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- CENTER and DRIFT act on the notes selected, or on all of them with none selected. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,8">
            <TextBlock x:Name="TakeName" Style="{StaticResource Label}" Margin="0,0,10,0" Foreground="#FF963A" />
            <TextBlock Style="{StaticResource Label}" Text="CENTER" />
            <Slider x:Name="CenterSlider" Width="130" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Correction_ValueChanged" />
            <TextBlock x:Name="CenterText" Width="40" VerticalAlignment="Center" Margin="6,0,0,0" />
            <TextBlock Style="{StaticResource Label}" Text="DRIFT" />
            <Slider x:Name="DriftSlider" Width="130" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Correction_ValueChanged" />
            <TextBlock x:Name="DriftText" Width="40" VerticalAlignment="Center" Margin="6,0,0,0" />
            <Button Content="CORRECT ALL" Margin="12,0,0,0" Click="CorrectAll_Click" />
            <Button Content="RESET" Click="Reset_Click" />
            <TextBlock Style="{StaticResource Label}" Text="ZOOM" />
            <Slider x:Name="ZoomSlider" Width="110" Minimum="40" Maximum="600" Value="160" VerticalAlignment="Center" ValueChanged="Zoom_ValueChanged" />
            <Button x:Name="PlayButton" Content="PLAY" Margin="18,0,0,0" Click="Play_Click" />
            <Button Content="APPLY" Click="Apply_Click" />
        </StackPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="10,4,10,6" FontFamily="Segoe UI" FontSize="12" Foreground="#AEB2B8" TextWrapping="Wrap" />
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <local:SondyneView x:Name="View" Focusable="True" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
    </DockPanel>
</Window>
