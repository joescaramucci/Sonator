<Window x:Class="Sonator.MidiImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import MIDI"
        Width="500"
        Height="220"
        Background="#1B2330"
        Foreground="#C4CFDA"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#212D3A" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="BorderBrush" Value="#607A96" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A3948" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#354D69" />
                    <Setter Property="BorderBrush" Value="#7EB2FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="L'importazione MIDI sostituirà il brano e i pattern correnti."
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />
        <TextBlock Grid.Row="1"
                   Text="Seleziona il file MIDI da importare:"
                   Margin="0,0,0,8" />

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilePathTextBox"
                     Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,8,0" />
            <Button Grid.Column="1"
                    Width="88"
                    Content="Browse..."
                    Click="BrowseButton_Click" />
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="#D98A8A"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel" Width="88" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Import" Width="88" IsDefault="True" Click="ImportButton_Click" />
        </StackPanel>
    </Grid>
</Window>
