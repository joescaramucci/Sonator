<Window x:Class="Sonator.WaveformEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waveform editor"
        Width="1080"
        Height="520"
        Background="#1B2330"
        Foreground="#C4CFDA"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#212D3A" />
            <Setter Property="Foreground" Value="#C4CFDA" />
            <Setter Property="BorderBrush" Value="#607A96" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <WrapPanel DockPanel.Dock="Top">
            <Button Content="Open..." Click="OpenButton_Click" />
            <Button Content="Play" Click="PlayButton_Click" />
            <Button Content="Play selection" Click="PlaySelectionButton_Click" />
            <Button Content="Stop" Click="StopButton_Click" />
            <Button Content="Cut" Click="CutButton_Click" />
            <Button Content="Copy" Click="CopyButton_Click" />
            <Button Content="Paste" Click="PasteButton_Click" />
            <Button Content="Delete" Click="DeleteButton_Click" />
            <Button Content="Normalize" Click="NormalizeButton_Click" />
            <Button Content="Fade in" Click="FadeInButton_Click" />
            <Button Content="Fade out" Click="FadeOutButton_Click" />
            <TextBlock Text="Clip BPM" VerticalAlignment="Center" Margin="6,0,4,6" />
            <TextBox x:Name="ClipBpmBox" Text="120" Width="60" VerticalContentAlignment="Center" Margin="0,0,6,6" />
            <Button Content="Stretch to song tempo" Click="StretchButton_Click" />
            <Button Content="Send to empty track" Click="SendToTrackButton_Click" />
            <Button Content="Undo" Click="UndoButton_Click" />
            <Button Content="Save as WAV..." Click="SaveButton_Click" />
        </WrapPanel>
        <TextBlock x:Name="InfoText" DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="11" Opacity="0.85" TextWrapping="Wrap" />
        <Border BorderBrush="#607A96" BorderThickness="1" Background="#141B24">
            <Canvas x:Name="WaveCanvas" Width="1000" Height="360" Background="Transparent"
                    MouseLeftButtonDown="WaveCanvas_MouseLeftButtonDown"
                    MouseMove="WaveCanvas_MouseMove"
                    MouseLeftButtonUp="WaveCanvas_MouseLeftButtonUp" />
        </Border>
    </DockPanel>
</Window>
