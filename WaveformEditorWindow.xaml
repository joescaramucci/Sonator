<Window x:Class="Sonator.WaveformEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waveform editor"
        Width="1080"
        Height="520"
        Background="#2D2D2D"
        Foreground="#D2D3D5"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#353535" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#607A96" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <WrapPanel DockPanel.Dock="Top">
            <Button Content="Open..." Click="OpenButton_Click" />
            <Button Content="Play" Click="PlayButton_Click" />
            <Button Content="Play selection" Click="PlaySelectionButton_Click" />
            <Button Content="Stop" Click="StopButton_Click" />
            <Button Content="Cut" Click="CutButton_Click" />
            <Button Content="Copy" Click="CopyButton_Click" />
            <Button Content="Paste" Click="PasteButton_Click" />
            <Button Content="Delete" Click="DeleteButton_Click" />
            <Button Content="Normalize" Click="NormalizeButton_Click" />
            <Button Content="Fade in" Click="FadeInButton_Click" />
            <Button Content="Fade out" Click="FadeOutButton_Click" />
            <TextBlock Text="Clip BPM" VerticalAlignment="Center" Margin="6,0,4,6" />
            <TextBox x:Name="ClipBpmBox" Text="120" Width="60" VerticalContentAlignment="Center" Margin="0,0,6,6" />
            <CheckBox x:Name="SnapCheckBox" Content="Snap" Foreground="#D2D3D5" VerticalAlignment="Center" Margin="2,0,8,6"
                      ToolTip="The selection's ends go to the song's grid: sixteenths, beats or bars, the finest one drawn" />
            <Button Content="Stretch to song tempo" Click="StretchButton_Click" />
            <Button Content="Send to track" Click="SendToTrackButton_Click"
                    ToolTip="Put the clip, or the selected part, into the selected track: the track it was opened from, or an empty one" />
            <Button Content="Undo" Click="UndoButton_Click" />
            <Button Content="Save as WAV..." Click="SaveButton_Click" />
        </WrapPanel>
        <TextBlock x:Name="InfoText" DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="11" Opacity="0.85" TextWrapping="Wrap" />
        <!-- The part of the clip in view, when zoomed in with the wheel. -->
        <ScrollBar x:Name="ViewScrollBar" DockPanel.Dock="Bottom" Orientation="Horizontal" Height="14" Margin="0,4,0,0"
                   IsEnabled="False" Scroll="ViewScrollBar_Scroll" />
        <!-- The mouse is taken by the whole frame, its edges too: a press on the left edge selects from the clip's start. -->
        <Border x:Name="WaveBorder" BorderBrush="#607A96" BorderThickness="1" Background="#242424"
                Focusable="True" FocusVisualStyle="{x:Null}" Cursor="IBeam"
                MouseLeftButtonDown="WaveCanvas_MouseLeftButtonDown"
                MouseMove="WaveCanvas_MouseMove"
                MouseLeftButtonUp="WaveCanvas_MouseLeftButtonUp"
                MouseWheel="WaveCanvas_MouseWheel">
            <Canvas x:Name="WaveCanvas" Height="360" Background="Transparent" ClipToBounds="True"
                    SizeChanged="WaveCanvas_SizeChanged" />
        </Border>
    </DockPanel>
</Window>
