<Window x:Class="Sonator.SoundBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sonator"
        Title="Sounds"
        Width="1100"
        Height="680"
        MinWidth="700"
        MinHeight="400"
        Background="#28292B"
        Foreground="#D2D3D5"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3D3E40" />
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="BorderBrush" Value="#5C7A99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource Raised3D}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555658" />
                    <Setter Property="BorderBrush" Value="#7EB2FF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Rows of the category and sound lists: dark, with the selection in the accent colour. -->
        <Style x:Key="DarkRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#D2D3D5" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#393A3C" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#2F5A7A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Rows of the sound list: the sounds coming up (under the mouse's, or the selected one) are lit, and
             a green dot marks those ready to be heard at once. -->
        <Style x:Key="SoundRow" TargetType="ListBoxItem" BasedOn="{StaticResource DarkRow}">
            <EventSetter Event="MouseEnter" Handler="SoundRow_MouseEnter" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <DockPanel>
                                <Ellipse x:Name="ReadyDot" DockPanel.Dock="Left" Width="6" Height="6" Margin="0,0,4,0" Fill="#49B88D" Visibility="Hidden"
                                         ToolTip="Ready: heard at once" />
                                <TextBlock x:Name="FavoriteStar" DockPanel.Dock="Left" Text="★" Width="14" Foreground="#E6C45B" Visibility="Hidden"
                                           ToolTip="A favorite" />
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="local:SoundBrowserWindow.IsComingUp" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#333436" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="#E6C45B" />
                            </Trigger>
                            <Trigger Property="local:SoundBrowserWindow.IsReady" Value="True">
                                <Setter TargetName="ReadyDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="local:SoundBrowserWindow.IsFavorite" Value="True">
                                <Setter TargetName="FavoriteStar" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#393A3C" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#2F5A7A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="SOUNDS" FontFamily="Segoe UI Semibold" FontSize="20" Foreground="#EFF0F2" />
                <TextBlock x:Name="TargetText" Foreground="#98999B" FontSize="11" />
            </StackPanel>
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Bottom" Foreground="#98999B" FontSize="11" />
            <Border Margin="24,4,16,0" Height="30" CornerRadius="5" Background="#1A1B1D" BorderBrush="#6C6D6F" BorderThickness="1" VerticalAlignment="Center">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Background="Transparent"
                             Foreground="#EFF0F2"
                             CaretBrush="#EFF0F2"
                             BorderThickness="0"
                             FontSize="14"
                             Padding="8,4"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"
                             AutomationProperties.Name="SEARCH SOUNDS" />
                    <TextBlock Text="Search: sax, violin, piano, warm pad, motown, ballad fill..." Margin="10,0" VerticalAlignment="Center" Foreground="#77787A" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="LoadButton" DockPanel.Dock="Right" Content="LOAD ON TRACK" Width="150" IsEnabled="False" Click="LoadButton_Click"
                    ToolTip="Load the sound on the selected track (or double-click it, or press Enter)" />
            <Button x:Name="PreviewButton" DockPanel.Dock="Right" Content="▶ PREVIEW" Width="110" Margin="0,0,8,0" IsEnabled="False" Click="PreviewButton_Click"
                    ToolTip="Hear the sound before loading it: a short phrase, or the start of a groove (Space in the list)" />
            <ToggleButton x:Name="AutoPreviewToggle" DockPanel.Dock="Right" Content="AUTO" IsChecked="True" Width="60" Height="28" Margin="0,0,8,0"
                          FontFamily="Consolas" FontWeight="SemiBold" Cursor="Hand"
                          ToolTip="Hear each sound as it is selected, with the arrows or a click. The sounds coming up are got ready ahead, lit in the list">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Background" Value="#3D3E40" />
                        <Setter Property="Foreground" Value="#D2D3D5" />
                        <Setter Property="Template" Value="{StaticResource Raised3D}" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#49B88D" />
                                <Setter Property="Foreground" Value="#0F1A14" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#B9BABC" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#242527" BorderBrush="#444547" BorderThickness="1" CornerRadius="5">
                <ListBox x:Name="CategoryList"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="4"
                         ItemContainerStyle="{StaticResource DarkRow}"
                         SelectionChanged="CategoryList_SelectionChanged"
                         AutomationProperties.Name="CATEGORIES">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="#98999B" />
                                <TextBlock Text="{Binding Label}" FontSize="13" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Background="#242527" BorderBrush="#444547" BorderThickness="1" CornerRadius="5">
                <DockPanel Margin="4">
                    <Grid x:Name="SortHeaders" DockPanel.Dock="Top" Margin="6,2,22,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="NAME" Tag="Name" FontWeight="Bold" Foreground="#ACADAF" Cursor="Hand" MouseLeftButtonDown="SortHeader_MouseLeftButtonDown" ToolTip="Sort by name, grouping the sounds; click again for the other way" />
                        <TextBlock Grid.Column="1" Text="CATEGORY" Tag="Category" FontWeight="Bold" Foreground="#ACADAF" Cursor="Hand" MouseLeftButtonDown="SortHeader_MouseLeftButtonDown" ToolTip="Sort by category, grouping the sounds; click again for the other way" />
                        <TextBlock Grid.Column="2" Text="INSTRUMENT" Tag="Instrument" FontWeight="Bold" Foreground="#ACADAF" Cursor="Hand" MouseLeftButtonDown="SortHeader_MouseLeftButtonDown" ToolTip="Sort by instrument, grouping the sounds; click again for the other way" />
                        <TextBlock Grid.Column="3" Text="BANK" Tag="Bank" FontWeight="Bold" Foreground="#ACADAF" Cursor="Hand" MouseLeftButtonDown="SortHeader_MouseLeftButtonDown" ToolTip="Sort by bank, grouping the sounds; click again for the other way" />
                        <TextBlock Grid.Column="4" Text="DESIGNER" Tag="Designer" FontWeight="Bold" Foreground="#ACADAF" Cursor="Hand" MouseLeftButtonDown="SortHeader_MouseLeftButtonDown" ToolTip="Sort by designer, grouping the sounds; click again for the other way" />
                    </Grid>
                    <ListBox x:Name="SoundList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource SoundRow}"
                             ScrollViewer.ScrollChanged="SoundList_ScrollChanged"
                             ContextMenuOpening="SoundList_ContextMenuOpening"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="SoundList_SelectionChanged"
                             MouseDoubleClick="SoundList_MouseDoubleClick"
                             PreviewKeyDown="SoundList_PreviewKeyDown"
                             AutomationProperties.Name="SOUNDS">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Subcategory}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#EFF0F2" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Category}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding PluginName}" Foreground="#9FD3F2" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding Bank}" Foreground="#B9BABC" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding Designer}" Foreground="#98999B" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
